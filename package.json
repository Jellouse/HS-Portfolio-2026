{
  "name": "humansize",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test:touch-guard": "node tests/touch-scroll-guard.mjs",
    "test:scroll": "node tests/mobile-scroll.spec.mjs",
    "test:canvas": "node tests/canvas-auth.spec.mjs",
    "test": "npm run test:touch-guard && npm run test:canvas && npm run test:scroll && npm run test:project-images && npm run test:keystatic",
    "test:preview-images": "node tests/preview-images.spec.mjs",
    "optimize:images": "node scripts/optimize-content-images.mjs",
    "test:keystatic": "node tests/keystatic-smoke.spec.mjs",
    "test:project-images": "node tests/project-images.spec.mjs",
    "postinstall": "node scripts/patch-keystatic.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^8.2.11",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^5.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
