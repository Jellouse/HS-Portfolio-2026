---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { getSite } from '../lib/content';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: unknown;
}

const { title, description, image, type, jsonLd } = Astro.props;
const site = await getSite();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={title} description={description} image={image} type={type} jsonLd={jsonLd} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <svg class="squircle-def" width="0" height="0" aria-hidden="true">
      <defs>
        <clipPath id="squircle" clipPathUnits="objectBoundingBox">
          <path
            d="M0.5,0 C0.85,0 1,0.15 1,0.5 C1,0.85 0.85,1 0.5,1 C0.15,1 0,0.85 0,0.5 C0,0.15 0.15,0 0.5,0 Z"
          />
        </clipPath>
      </defs>
    </svg>
    <Header site={site} />
    <main id="content">
      <slot />
    </main>
    <Footer site={site} />
    <script is:inline>
      (function () {
        function tick() {
          document.querySelectorAll('[data-tokyo-time]').forEach(function (el) {
            var zone = el.getAttribute('data-timezone') || 'Asia/Tokyo';
            var place = el.getAttribute('data-place') || 'Tokyo';
            var time = new Intl.DateTimeFormat('en-GB', {
              timeZone: zone,
              hour: '2-digit',
              minute: '2-digit',
              hourCycle: 'h23',
            }).format(new Date());
            el.textContent = place + ', ' + time;
          });
        }
        tick();
        setInterval(tick, 30000);

        document.querySelectorAll('.frame img').forEach(function (img) {
          var mark = function () {
            img.classList.add('is-ready');
          };
          if (img.complete) mark();
          else img.addEventListener('load', mark, { once: true });
        });

        document.querySelectorAll('.contact').forEach(function (el) {
          var button = el.querySelector('.contact-label');
          if (!button) return;
          button.addEventListener('click', function () {
            if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            el.classList.toggle('is-open');
          });
        });

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          document.querySelectorAll('.contact.is-open').forEach(function (el) {
            el.classList.remove('is-open');
          });
        });
      })();
    </script>
  </body>
</html>
