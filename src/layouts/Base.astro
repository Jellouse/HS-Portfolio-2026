---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ContactSheet from '../components/ContactSheet.astro';
import Seo from '../components/Seo.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getSite } from '../lib/content';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  noindex?: boolean;
  /** viewport-fit=cover, so env(safe-area-inset-*) works (pages with bottom-pinned UI). */
  safeArea?: boolean;
}

const { title, description, image, type, jsonLd, noindex = false, safeArea = false } = Astro.props;
const site = await getSite();
---

<html lang="en" data-dev={import.meta.env.DEV ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <!-- Cross-page view transitions: the opt-in lives inline at the top of <head>, so the
         incoming page has it on its very first render even when the stylesheet is still
         downloading (otherwise Chrome skips the morph: "opt-in disabled"). The expect link
         holds that first render until <main> is parsed, so the shared mark exists in it. -->
    <style is:inline>@view-transition{navigation:auto}@media (prefers-reduced-motion:reduce){@view-transition{navigation:none}}</style>
    <link rel="expect" href="#content" blocking="render" />
    <style is:inline>.reveal-gate:not(.canvas-mode) :is(main :is(p,h1,h2,h3,h4,li,blockquote,figcaption,.caption,.project-summary),.site-footer :is(p,li)):not(.is-split,.is-split *,.sr-only,[data-no-reveal],[data-no-reveal] *){opacity:0}.is-split{transition:opacity 350ms cubic-bezier(.16,1,.3,1)}</style>
    <script is:inline>
      // Ring morph direction, so CSS can show only the larger (sharper) snapshot of the mark.
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (vt && vt.types) vt.types.add(document.querySelector('.shop-detail-mark') ? 'ib-shrink' : 'ib-grow');
        if (vt) {
          var html = document.documentElement;
          html.classList.add('vt-incoming');
          vt.finished.finally(function () { html.classList.remove('vt-incoming'); });
        }
      });
    </script>
    <meta name="viewport" content={`width=device-width, initial-scale=1${safeArea ? ', viewport-fit=cover' : ''}`} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="google-site-verification" content="M6eRTJDg2gB4PMiLKpzNVeRX6jugbsgeBjGd_0ci2V4" />
    <link rel="preload" href="/fonts/ABCAreal-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} image={image} type={type} jsonLd={jsonLd} noindex={noindex} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Text reveal gate: text hosts stay transparent from first paint until text-reveal.ts
      // has split them, then fade in, so text never shows sharp first and blurs after.
      // Reduced motion skips the reveal, so no gate; the timeout is a failsafe if JS stalls.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-gate');
        setTimeout(function () { document.documentElement.classList.remove('reveal-gate'); }, 3000);
      }
      (function () {
        var q = new URLSearchParams(location.search);
        var value = q.get('grid');
        if (value !== null && value !== '0' && value !== 'false' && value !== 'off')
          document.documentElement.classList.add('show-grid');
        // G toggles the column overlay, in dev or on the /canvas board only.
        if (!(document.documentElement.hasAttribute('data-dev') || q.get('canvas') === '1')) return;
        addEventListener('keydown', function (e) {
          if ((e.key !== 'g' && e.key !== 'G') || e.metaKey || e.ctrlKey || e.altKey) return;
          var t = e.target;
          if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
          document.documentElement.classList.toggle('show-grid');
        });
      })();
    </script>
    <script is:inline>
      // ?canvas=1&vh=N (the /canvas board): the iframe is as tall as the page, so viewport
      // units are re-based on N px, reveals show their end state, and the page height is
      // posted to the parent. Without the param this does nothing.
      (function () {
        var q = new URLSearchParams(location.search);
        if (q.get('canvas') !== '1') return;
        var vh = Number(q.get('vh')) || 900;
        var root = document.documentElement;
        root.classList.add('canvas-mode');
        // canvas frames are review copies: keep them out of search indexes
        var robots = document.querySelector('meta[name="robots"]') || document.head.appendChild(document.createElement('meta'));
        robots.setAttribute('name', 'robots');
        robots.setAttribute('content', 'noindex, nofollow');
        root.style.setProperty('--canvas-vh', vh / 100 + 'px');
        var unit = /(-?\d*\.?\d+)(s|d|l)?vh\b/g;
        function rebase(rules, out) {
          for (var i = 0; i < rules.length; i++) {
            var r = rules[i];
            if (r.cssRules && r.cssRules.length && !(r instanceof CSSStyleRule)) {
              var inner = [];
              rebase(r.cssRules, inner);
              if (inner.length) {
                var head = r.cssText.slice(0, r.cssText.indexOf('{'));
                out.push(head + '{' + inner.join('') + '}');
              }
            } else if (r.style && unit.test(r.cssText)) {
              unit.lastIndex = 0;
              out.push(r.cssText.replace(unit, 'calc($1 * var(--canvas-vh))'));
            }
            unit.lastIndex = 0;
          }
        }
        function apply() {
          var out = [];
          for (var i = 0; i < document.styleSheets.length; i++) {
            try { rebase(document.styleSheets[i].cssRules, out); } catch (e) {}
          }
          var st = document.createElement('style');
          st.textContent =
            out.join('\n') +
            '.canvas-mode .fade-in,.canvas-mode .reveal-word,.canvas-mode .reveal-pending .reveal-word{opacity:1!important;filter:none!important;transform:none!important;animation:none!important;transition:none!important}astro-dev-toolbar{display:none!important}';
          document.head.appendChild(st);
          var last = 0;
          function post() {
            var h = Math.ceil(Math.max(document.body.scrollHeight, root.scrollHeight));
            if (Math.abs(h - last) < 2) return;
            last = h;
            parent.postMessage({ type: 'canvas-height', href: location.pathname, h: h }, '*');
          }
          new ResizeObserver(post).observe(document.body);
          addEventListener('load', post);
          post();
        }
        // Esc inside a frame hands control back to the board.
        addEventListener('keydown', function (e) {
          if (e.key === 'Escape') parent.postMessage({ type: 'canvas-escape' }, '*');
        });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
        else apply();
      })();
    </script>
  </head>
  <body>
    <svg class="squircle-def" width="0" height="0" aria-hidden="true">
      <defs>
        <clipPath id="squircle" clipPathUnits="objectBoundingBox">
          <path
            d="M0.5,0 C0.85,0 1,0.15 1,0.5 C1,0.85 0.85,1 0.5,1 C0.15,1 0,0.85 0,0.5 C0,0.15 0.15,0 0.5,0 Z"
          />
        </clipPath>
      </defs>
    </svg>
    <Header site={site} />
    <main id="content">
      <slot />
    </main>
    <Footer site={site} />
    <ContactSheet email={site.email} />
    <div class="grid-overlay" aria-hidden="true">
      <div class="page-grid">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    <script>
      import '../scripts/haptics';
    </script>
    <script is:inline>
      (function () {
        document.querySelectorAll('.frame img').forEach(function (img) {
          var mark = function () {
            img.classList.add('is-ready');
          };
          if (img.complete) mark();
          else img.addEventListener('load', mark, { once: true });
        });

        // Mirror the open states onto the header as plain classes. Safari does not reliably
        // re-match .site-header:has(.who.is-open) when a child's class flips, so the time and
        // @Humansize ended up visible on top of each other. Plain classes always restyle.
        document.querySelectorAll('.site-header').forEach(function (header) {
          var sync = function () {
            header.classList.toggle('is-time-open', !!header.querySelector('.who.is-open'));
            var open = !!header.querySelector('.contact.is-open');
            var was = header.classList.contains('is-menu-open');
            header.classList.toggle('is-menu-open', open);
            if (open) header.classList.remove('is-menu-fade', 'is-menu-snap');
            // Menu closing: the time comes back instantly, unless the 5s timer closed it (crossfade).
            if (was && !open) {
              var cls = window.__hsTimerClose ? 'is-menu-fade' : 'is-menu-snap';
              window.__hsTimerClose = false;
              header.classList.remove('is-menu-fade', 'is-menu-snap');
              header.classList.add(cls);
              setTimeout(function () { header.classList.remove(cls); }, 700);
            }
          };
          new MutationObserver(function (list) {
            if (list.some(function (m) { return m.target !== header; })) sync();
          }).observe(header, { subtree: true, attributes: true, attributeFilter: ['class'] });
          sync();
        });

        // phones: an open menu or time closes itself after 5s
        var autoClose = 0;
        var armClose = function (el) {
          clearTimeout(autoClose);
          if (!el.classList.contains('is-open')) return;
          if (!window.matchMedia('(max-width: 759px)').matches) return;
          autoClose = setTimeout(function () {
            window.__hsTimerClose = true;
            el.classList.remove('is-open');
            setTimeout(function () { window.__hsTimerClose = false; }, 0);
          }, 5000);
        };

        document.querySelectorAll('.contact').forEach(function (el) {
          var button = el.querySelector('.contact-label');
          if (!button) return;
          button.addEventListener('click', function () {
            if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            el.classList.toggle('is-open');
            if (el.classList.contains('is-open')) {
              document.querySelectorAll('.who.is-open').forEach(function (who) {
                who.classList.remove('is-open');
              });
            }
            armClose(el);
          });
        });

        // touch phones: tapping the name toggles the Tokyo time instead of navigating
        document.querySelectorAll('.who').forEach(function (who) {
          var link = who.querySelector('a');
          if (!link) return;
          link.addEventListener('click', function (event) {
            if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            if (!window.matchMedia('(max-width: 759px)').matches) return;
            event.preventDefault();
            who.classList.toggle('is-open');
            if (who.classList.contains('is-open')) {
              document.querySelectorAll('.contact.is-open').forEach(function (el) {
                el.classList.remove('is-open');
              });
            }
            armClose(who);
          });
        });

        // a tap outside an open menu or time closes it
        // iOS only fires click on "clickable" elements, so a tap on blank page never closed
        // the menu. pointerdown fires on every tap.
        var closeOutside = function (event) {
          document.querySelectorAll('.contact.is-open, .who.is-open').forEach(function (el) {
            if (!el.contains(event.target)) el.classList.remove('is-open');
          });
        };
        document.addEventListener('click', closeOutside);
        document.addEventListener('pointerdown', closeOutside);

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          document.querySelectorAll('.contact.is-open').forEach(function (el) {
            el.classList.remove('is-open');
          });
        });

        var marks = Array.prototype.filter.call(document.querySelectorAll('.mark'), function (m) {
          // Blob keeps source proportions; only gradient Mark stretches.
          return !m.closest('[hidden]') && !m.classList.contains('mark-blob') && !m.classList.contains('mark-face');
        });
        if (marks.length) {
          var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
          // Blob rests wider; gradient mark rests at 1. Read from the visible mark.
          var restOf = function (el) {
            var raw = getComputedStyle(el).getPropertyValue('--mark-scale').trim();
            var n = parseFloat(raw);
            return n && n > 0 ? n : 1;
          };
          var rest = restOf(marks[0]);
          var current = rest;
          var target = rest;
          var frame = 0;

          var paint = function () {
            var value = current.toFixed(4);
            marks.forEach(function (mark) {
              mark.style.setProperty('--mark-scale', value);
            });
          };

          var tick = function () {
            current += (target - current) * 0.12;
            if (Math.abs(target - current) < 0.0008) {
              current = target;
              paint();
              frame = 0;
              return;
            }
            paint();
            frame = requestAnimationFrame(tick);
          };

          var wake = function () {
            if (!frame) frame = requestAnimationFrame(tick);
          };

          var stretchMax = function () {
            var max = parseFloat(
              getComputedStyle(document.documentElement).getPropertyValue('--mark-stretch-max'),
            );
            if (!max || max < rest) max = Math.max(1.35, rest * 1.15);
            return max;
          };

          window.addEventListener('pointermove', function (event) {
            if (!fine.matches || reduce.matches || event.pointerType === 'touch') return;
            var distance = Math.abs(event.clientX - window.innerWidth / 2);
            var reach = Math.min(1, distance / (window.innerWidth / 2));
            var max = stretchMax();
            target = rest + (max - rest) * reach * reach;
            wake();
          });

          document.documentElement.addEventListener('pointerleave', function () {
            target = rest;
            wake();
          });
        }
      })();
    </script>
    <script>
      import { startInput } from '../scripts/input';
      import { initTextReveal } from '../scripts/text-reveal';
      import { initScrollFade } from '../scripts/scroll-fade';
      startInput();
      initTextReveal();
      initScrollFade();
    </script>
    <!-- Vercel Web Analytics (cookieless page views). -->
    <Analytics />
    <!-- Vercel Speed Insights (real-user Core Web Vitals). -->
    <SpeedInsights />
  </body>
</html>
