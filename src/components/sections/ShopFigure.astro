---
import BlurImage from '../BlurImage.astro';
import { resolveImageSource } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  outline?: boolean;
  priority?: boolean;
}

const { src, alt, sizes, outline = false, priority = false } = Astro.props;
---

<figure class="shop-detail-image fade-in">
  <BlurImage src={resolveImageSource(src)} alt={alt} outline={outline} sizes={sizes} priority={priority} />
</figure>
