---
import { priceText } from '../../lib/shop';
import Price from './Price.astro';

interface Props {
  title: string;
  slug: string;
  eur: number | null;
}

const { title, slug, eur } = Astro.props;
const price = priceText(eur, 'suffix');
---

<header class="shop-detail-head">
  <h1>
    {title}{price ? <span class="project-year"><Price slug={slug} mode="suffix" text={price} /></span> : null}
  </h1>
</header>
