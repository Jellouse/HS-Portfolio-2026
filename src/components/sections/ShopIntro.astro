---
import Prose from './Prose.astro';

const paragraphs = [
  'Industrial Bloom is a range of solid aluminium vases. The name is a play on "industrial boom". Each vase is made from aluminium extrusion, a heavy-duty building material, and brings it into the home to hold something as delicate as flowers.',
  "They come in several sizes and are made and shipped from Europe. They're heavy and solid. If one falls, it won't break.",
  'To see how they\'re made, visit the [Industrial Bloom](/work/industrial-bloom/) project page.',
];
---

<section class="shop-intro" id="shop-about" tabindex="-1" aria-label="About Industrial Bloom">
  <Prose paragraphs={paragraphs} />
</section>
