---
interface Props {
  variant: 'header' | 'shop' | 'project';
  home?: boolean;
}

const { variant, home = false } = Astro.props;
---

{
  variant === 'header' && (
    <nav class="site-menu" aria-label="Main" data-main-menu>
      {home ? <a href="#about" data-about-link>About</a> : <a href="/">Home</a>}
      <a href="/shop">Shop</a>
      <button type="button" data-contact-open>Contact</button>
    </nav>
  )
}
{
  variant === 'shop' && (
    <nav class="site-menu shop-menu" aria-label="Main">
      <a href="/">Home</a>
      <a href="#shop-about" data-shop-about>About</a>
      <button type="button" data-contact-open>Contact</button>
    </nav>
  )
}
{
  variant === 'project' && (
    <nav class="project-menu" aria-label="Main">
      <a href="/" style="--i: -1">Home</a>
      <a href="/shop" style="--i: 0">Shop</a>
      <button type="button" data-contact-open style="--i: 1">Contact</button>
    </nav>
  )
}
