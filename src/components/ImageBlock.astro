---
import BlurImage from './BlurImage.astro';
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  frame?: 'full' | 'wide' | 'medium' | 'narrow';
  priority?: boolean;
}

const { src, alt, frame = 'full', priority = false } = Astro.props;
const image = resolveImage(src);
const sizes = {
  full: '(min-width: 1200px) 1120px, 100vw',
  wide: '(min-width: 1200px) 848px, 100vw',
  medium: '(min-width: 1200px) 652px, 100vw',
  narrow: '(min-width: 760px) 420px, 100vw',
}[frame];
---

<figure class="image-block" data-frame={frame}>
  <BlurImage src={image} alt={alt} sizes={sizes} priority={priority} />
</figure>
