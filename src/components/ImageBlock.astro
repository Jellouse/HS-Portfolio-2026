---
import BlurImage from './BlurImage.astro';
import { resolveImageSource } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  frame?: 'full' | 'wide' | 'medium' | 'narrow';
  priority?: boolean;
  flush?: boolean;
}

const { src, alt, frame = 'full', priority = false, flush = false } = Astro.props;
const image = resolveImageSource(src);
const sizes = '(min-width: 760px) 552px, calc(100vw - 40px)';
---

<figure class="image-block fade-in" data-frame={frame}>
  <BlurImage src={image} alt={alt} sizes={sizes} priority={priority} flush={flush} />
</figure>
