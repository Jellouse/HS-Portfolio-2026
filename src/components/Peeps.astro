---
import PeepsStatic from './PeepsStatic.astro';

interface Props {
  maxH?: number;
}

const { maxH } = Astro.props;
---

<div class="peeps" data-peeps data-max-h={maxH}>
  <PeepsStatic />
</div>

<script>
  import { mountFaces } from '../scripts/faces';
  document.querySelectorAll<HTMLElement>('[data-peeps]').forEach((el) => mountFaces(el));
</script>
