---
interface Item {
  role: string;
  name: string;
  url?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="credits">
      <h2 class="credits-label">Credits</h2>
      <ul class="credits-list">
        {items.map((item) => (
          <li>
            {item.role}: {item.url ? <a href={item.url}>{item.name}</a> : item.name}
          </li>
        ))}
      </ul>
    </section>
  )
}
