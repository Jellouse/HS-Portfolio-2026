---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section>
      <h2>Credit</h2>
      <dl>
        {items.map((item) => (
          <>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </>
        ))}
      </dl>
    </section>
  )
}
