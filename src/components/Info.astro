---
interface Item {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="info">
      <h2 class="info-label">Info</h2>
      <ul class="info-list">
        {items.map((item) => (
          <li>
            {item.label}: {item.href ? <a href={item.href}>{item.value}</a> : item.value}
          </li>
        ))}
      </ul>
    </section>
  )
}
