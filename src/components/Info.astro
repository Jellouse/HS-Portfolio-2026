---
interface Item {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const fixUrl = (url: string) => (/^(https?:|mailto:|\/|#)/.test(url) ? url : `https://${url}`);
const parts = (value: string) =>
  value.split(/(\[[^\]]+\]\([^)\s]+\))/).filter(Boolean).map((chunk) => {
    const m = chunk.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
    return m ? { text: m[1], href: fixUrl(m[2]) } : { text: chunk };
  });
---

{
  items.length > 0 && (
    <section class="info">
      <h2 class="info-label">Info</h2>
      <ul class="info-list">
        {items.map((item) => (
          <li>
            {item.label}: {item.href ? <a href={item.href}>{item.value}</a> : parts(item.value).map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}
          </li>
        ))}
      </ul>
    </section>
  )
}
