---
import BlurImage from './BlurImage.astro';
import { resolveImage } from '../lib/images';

interface Photo {
  src: string;
  alt: string;
  flush?: boolean;
}

interface Props {
  images: Photo[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section class="process">
      <h2 class="process-label">Process</h2>
      <div class="process-grid">
        {images.map((image) => (
          <BlurImage
            src={resolveImage(image.src)}
            alt={image.alt}
            sizes="(min-width: 760px) 268px, calc((100vw - 56px) / 2)"
            flush={image.flush === true}
          />
        ))}
      </div>
    </section>
  )
}
