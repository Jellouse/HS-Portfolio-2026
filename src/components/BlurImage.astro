---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageHasAlpha } from '../lib/image-alpha';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes: string;
  priority?: boolean;
  plain?: boolean;
  flush?: boolean;

  outline?: boolean;
  fade?: boolean;
}

const { src, alt, sizes, priority = false, plain = false, flush = false, outline = false, fade = true } = Astro.props;
const remote = typeof src === 'string';
const widths = remote
  ? []
  : [...new Set([480, 768, 1100, 1600, 2000, src.width])].filter((width) => width <= src.width);
const alpha = !remote && (await imageHasAlpha(src));
const placeholder =
  remote || alpha
    ? null
    : await getImage({
        src,
        width: 24,
        format: 'webp',
        quality: 40,
      });
const frameClass = ['frame', { 'scroll-media': fade, 'is-plain': plain, 'is-flush': flush, 'is-outlined': outline, 'is-alpha': alpha }];
---

<div class:list={frameClass} style={placeholder ? `background-image:url('${placeholder.src}')` : undefined}>
  {
    remote ? (
      <img
        src={src}
        alt={alt}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format={alpha ? 'png' : undefined}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    )
  }
</div>
