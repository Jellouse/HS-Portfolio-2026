---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes: string;
  priority?: boolean;
  plain?: boolean;
  flush?: boolean;
}

const { src, alt, sizes, priority = false, plain = false, flush = false } = Astro.props;
const remote = typeof src === 'string';
const widths = remote
  ? []
  : [...new Set([480, 768, 1100, 1600, 2000, src.width])].filter((width) => width <= src.width);
const placeholder = remote
  ? null
  : await getImage({
      src,
      width: 24,
      format: 'webp',
      quality: 40,
    });
---

{
  remote ? (
    <div class:list={['frame', { 'is-plain': plain, 'is-flush': flush }]}>
      <img
        src={src}
        alt={alt}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </div>
  ) : (
    <div class:list={['frame', { 'is-plain': plain, 'is-flush': flush }]} style={`background-image:url('${placeholder!.src}')`}>
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </div>
  )
}
