---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  plain?: boolean;
  flush?: boolean;
}

const { src, alt, sizes, priority = false, plain = false, flush = false } = Astro.props;
const widths = [...new Set([480, 768, 1100, 1600, 2000, src.width])].filter(
  (width) => width <= src.width,
);
const placeholder = await getImage({
  src,
  width: 24,
  format: 'webp',
  quality: 40,
});
---

<div class:list={['frame', { 'is-plain': plain, 'is-flush': flush }]} style={`background-image:url('${placeholder.src}')`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>
