---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
}

const { src, alt, sizes, priority = false } = Astro.props;
const widths = [480, 768, 1100, 1600, 2000].filter((width) => width < src.width);
if (widths.length === 0) widths.push(src.width);
const placeholder = await getImage({
  src,
  width: 24,
  format: 'webp',
  quality: 40,
});
---

<div class="frame" style={`background-image:url('${placeholder.src}')`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>
