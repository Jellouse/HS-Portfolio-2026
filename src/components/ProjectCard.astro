---
import BlurImage from './BlurImage.astro';
import VideoFrame from './VideoFrame.astro';
import { resolveImage } from '../lib/images';
import { yearRange, type ProjectEntry } from '../lib/content';

interface Props {
  project: ProjectEntry;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { caption, cover, coverAlt, coverVideo, coverFrame, coverFlush, rounded } = project.data;
if (!coverVideo && (!cover || !coverAlt)) throw new Error(`${project.id} is missing a cover`);
const years = yearRange(project.data.year, project.data.yearEnd);
const base = caption.replace(/,\s*\d{4}(\s*\u2013\s*\d{4})?\s*$/, '');
const label = years ? `${base}, ${years}` : caption;
const image = cover ? resolveImage(cover) : undefined;
const sizes = {
  full: '(min-width: 1440px) 1120px, (min-width: 760px) 80vw, 100vw',
  wide: '(min-width: 1440px) 836px, (min-width: 760px) 60vw, 100vw',
  medium: '(min-width: 1440px) 552px, (min-width: 760px) 40vw, 100vw',
  narrow: '(min-width: 1440px) 410px, (min-width: 760px) 30vw, 100vw',
}[coverFrame];
---

<article class:list={['card', { 'is-plain': rounded === false }]} data-frame={coverFrame}>
  <a href={`/work/${project.id}`}>
    {coverVideo ? (
      <VideoFrame
        src={coverVideo}
        poster={image}
        label={coverAlt}
        plain={rounded === false}
        flush={coverFlush === true}
        priority={priority}
      />
    ) : (
      <BlurImage
        src={image!}
        alt={coverAlt ?? ''}
        sizes={sizes}
        priority={priority}
        plain={rounded === false}
        flush={coverFlush === true}
      />
    )}
  </a>
  <a class="caption" href={`/work/${project.id}`}>{label}</a>
</article>
