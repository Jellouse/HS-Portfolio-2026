---
import BlurImage from './BlurImage.astro';
import VideoFrame from './VideoFrame.astro';
import { resolveImageSource } from '../lib/images';
import { projectTitleParts, type ProjectEntry } from '../lib/content';

interface Props {
  project: ProjectEntry;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { cover, coverAlt, coverVideo, coverFrame, coverFlush, coverOutline, rounded } = project.data;
if (!coverVideo && (!cover || !coverAlt)) throw new Error(`${project.id} is missing a cover`);
const { title, years } = projectTitleParts(project.data);
const image = cover ? resolveImageSource(cover) : undefined;
const sizes = {
  wide: '(min-width: 1440px) 893px, (min-width: 760px) 70vw, 100vw',
  default: '(min-width: 1440px) 666px, (min-width: 760px) 55vw, 100vw',
}[coverFrame];
---

<article class:list={['card', 'fade-in', { 'is-plain': rounded === false }]} data-frame={coverFrame}>
  <a href={`/work/${project.id}/`}>
    {coverVideo ? (
      <VideoFrame
        src={coverVideo}
        poster={image}
        label={coverAlt}
        plain={rounded === false}
        flush={coverFlush === true}
        priority={priority}
      />
    ) : (
      <BlurImage
        src={image!}
        alt={coverAlt ?? ''}
        sizes={sizes}
        priority={priority}
        plain={rounded === false}
        flush={coverFlush === true}
        outline={coverOutline === true}
      />
    )}
  </a>
  <a class="caption" href={`/work/${project.id}/`}>
    {title}{years ? <>, <span class="project-year">{years}</span></> : null}
  </a>
</article>
