---
import Info from './Info.astro';
import ImageBlock from './ImageBlock.astro';
import ImagePair from './ImagePair.astro';
import ProcessBlock from './ProcessBlock.astro';
import TextBlock from './TextBlock.astro';
import VideoBlock from './VideoBlock.astro';
import type { ProjectEntry } from '../lib/content';
import { processFolderAlt, processFolderImages } from '../lib/images';
import { resolveProcessFolderForRender } from '../lib/project-blocks.mjs';

interface Props {
  blocks: ProjectEntry['data']['blocks'];
  slug?: string;
  processFromFolder?: boolean;

  processFolderSrcs?: string[];
  info?: { label: string; value: string; href?: string }[];
}

const { blocks, slug, processFromFolder = false, processFolderSrcs, info = [] } = Astro.props;

let infoShown = false;
const takeInfo = () => {
  if (infoShown) return false;
  infoShown = true;
  return true;
};
const rawFolderSrcs =
  processFolderSrcs ??
  (processFromFolder && slug ? processFolderImages(slug) : []);
const folderSrcs = resolveProcessFolderForRender(
  Boolean(processFromFolder),
  rawFolderSrcs,
  blocks,
);
const folder = folderSrcs.map((src) => ({ src, alt: processFolderAlt(src), flush: false }));
const useFolder = Boolean(processFromFolder) && folder.length > 0;
const hasProcessBlock = blocks.some((b) => b.discriminant === 'process');

let imageCount = 0;
const eager = () => imageCount++ < 2;
---

{
  blocks.map((block) => {
    if (block.discriminant === 'text') {
      return <TextBlock heading={block.value.heading} text={block.value.text} />;
    }
    if (block.discriminant === 'image') {
      return (
        <ImageBlock
          src={block.value.src}
          alt={block.value.alt}
          frame={block.value.frame}
          flush={block.value.flush}
          outline={block.value.outline}
          priority={eager()}
        />
      );
    }
    if (block.discriminant === 'video') {
      if (!block.value.src) return null;
      return (
        <VideoBlock
          src={block.value.src}
          poster={block.value.poster ?? undefined}
          label={block.value.alt ?? undefined}
          frame={block.value.frame}
          flush={block.value.flush}
          outline={block.value.outline}
        />
      );
    }
    if (block.discriminant === 'process') {
      return (
        <>
          {takeInfo() && <Info items={info} />}
          <ProcessBlock images={useFolder ? folder : block.value.images} />
        </>
      );
    }
    if (block.value.layout === 'stack') {
      return (
        <>
          <ImageBlock src={block.value.left} alt={block.value.leftAlt ?? ''} priority={eager()} frame={block.value.frame} outline={block.value.outline} />
          <ImageBlock src={block.value.right} alt={block.value.rightAlt ?? ''} priority={eager()} frame={block.value.frame} outline={block.value.outline} />
        </>
      );
    }
    return (
      <ImagePair
        left={block.value.left}
        leftAlt={block.value.leftAlt}
        right={block.value.right}
        rightAlt={block.value.rightAlt}
        frame={block.value.frame}
        outline={block.value.outline}
        leftPriority={eager()}
        rightPriority={eager()}
      />
    );
  })
}
{useFolder && !hasProcessBlock && (
  <>
    {takeInfo() && <Info items={info} />}
    <ProcessBlock images={folder} />
  </>
)}
{takeInfo() && <Info items={info} />}
