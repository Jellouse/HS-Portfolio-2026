---
import BlurImage from './BlurImage.astro';
import VideoFrame from './VideoFrame.astro';
import Prose from './sections/Prose.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { paragraphs } from '../lib/content';
import { resolveImageSource } from '../lib/images';
import { projectSlugForServiceImage, resolveServiceImage } from '../lib/service-images.mjs';
import { hasBracket, renderPlaceholders } from '../lib/services';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry: s } = Astro.props;
const d = s.data;
const inquireService = s.data.title;
const imageSizes = '(min-width: 760px) 666px, calc(100vw - 40px)';
const projects = new Map((await getCollection('projects')).map((project) => [project.id, project.data]));
const sections = d.sections.map((section, sectionIndex) => ({
  ...section,
  images: section.images.map((image, imageIndex) =>
    resolveServiceImage(
      image,
      projects.get(projectSlugForServiceImage(image)),
      `src/content/services/${s.id}.yaml sections[${sectionIndex}].images[${imageIndex}]`,
    ),
  ),
}));
const intro = paragraphs(d.intro);
const sectionSteps = sections.flatMap((section, sectionIndex) => [
  { kind: 'text' as const, section, sectionIndex },
  ...section.images.map((img, imageIndex) => ({
    kind: 'image' as const,
    section,
    img,
    sectionIndex,
    imageIndex,
  })),
]);
const stepCount =
  1 + (d.processSteps.length ? 1 : 0) + (intro.length ? 1 : 0) + sectionSteps.length + (d.faq.length ? 1 : 0);
---

<div class="arrow-nav service-steps is-controls" data-service-steps data-no-letter data-no-reveal data-chrome-vt>
  <a class="arrow-back" href="/services/" data-service-back aria-label="Back">
    <svg viewBox="0 0 21 20" aria-hidden="true">
      <path d="M2.11719 7H13.1172C16.4309 7 19.1172 9.68629 19.1172 13C19.1172 16.3137 16.4309 19 13.1172 19H5.98082" fill="none" stroke="currentColor" stroke-width="2"></path>
      <path d="M7.53027 13.2324L1.41406 7.11621L7.53027 0.999995" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </a>

  <button type="button" class="arrow-pill" data-dir="left" data-mode="icon" hidden aria-label="Previous">
    <svg class="arrow-chevron" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M17 9.88379L4.02555 9.88379" fill="none" stroke="currentColor" stroke-width="2"></path>
      <path d="M9.80322 16L3.68701 9.88379L9.80322 3.76757" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>
  <button type="button" class="arrow-pill" data-dir="right" data-mode="icon" hidden={stepCount < 2} aria-label="Next">
    <svg class="arrow-chevron" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M17 9.88379L4.02555 9.88379" fill="none" stroke="currentColor" stroke-width="2"></path>
      <path d="M9.80322 16L3.68701 9.88379L9.80322 3.76757" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>

  <div class="service-step-stage">
    <section class="service-step" data-step>
      <h1 class="service-step-title">{d.h1 || s.data.title}</h1>
      {d.subline && <p class="service-step-kicker">{d.subline}</p>}
    </section>

    {
      d.processSteps.length > 0 && (
        <section class="service-step" data-step hidden>
          <h2 class="service-step-kicker">{d.processHeading || 'How a project runs'}</h2>
          <div class="service-step-body">
            {d.processSteps.map((step) =>
              hasBracket(step.body) ? <p set:html={renderPlaceholders(step.body)} /> : <Prose paragraphs={[step.body]} />,
            )}
          </div>
        </section>
      )
    }

    {
      intro.length > 0 && (
        <section class="service-step" data-step hidden>
          <div class="service-step-body">
            {intro.map((paragraph) =>
              hasBracket(paragraph) ? <p set:html={renderPlaceholders(paragraph)} /> : <Prose paragraphs={[paragraph]} />,
            )}
          </div>
        </section>
      )
    }

    {
      sectionSteps.map((step) =>
        step.kind === 'text' ? (
          <section class="service-step" data-step hidden>
            <h2 class="service-step-title">{step.section.heading}</h2>
            <div class="service-step-body">
              {paragraphs(step.section.body).map((paragraph) =>
                hasBracket(paragraph) ? <p set:html={renderPlaceholders(paragraph)} /> : <Prose paragraphs={[paragraph]} />,
              )}
            </div>
          </section>
        ) : (
          <section class="service-step is-media" data-step hidden>
            <div class="service-step-images">
              <figure class="service-step-figure">
                {step.img.video ? (
                  <VideoFrame src={step.img.src} poster={step.img.poster ? resolveImageSource(step.img.poster) : undefined} label={step.img.alt} fade={false} priority={step.sectionIndex === 0 && step.imageIndex === 0} />
                ) : (
                  <BlurImage src={resolveImageSource(step.img.src)} alt={step.img.alt} sizes={imageSizes} fade={false} priority={step.sectionIndex === 0 && step.imageIndex === 0} />
                )}
                {step.img.caption && (
                  <figcaption class="service-step-caption">
                    {step.img.href ? <a href={step.img.href} set:html={renderPlaceholders(step.img.caption)} /> : <span set:html={renderPlaceholders(step.img.caption)} />}
                  </figcaption>
                )}
              </figure>
            </div>
          </section>
        ),
      )
    }

    {
      d.faq.length > 0 && (
        <section class="service-step" data-step hidden>
          <h2 class="service-step-title">FAQ</h2>
          <div class="service-step-body">
            {d.faq.map((item) => (
              <details class="service-faq" name="service-faq">
                <summary>{item.question}</summary>
                <p class="service-step-kicker" set:html={renderPlaceholders(item.answer)} />
              </details>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <button type="button" class="service-inquire" data-contact-open data-contact-service={inquireService}>Inquire</button>
</div>

<script>
  import { initServiceSteps } from '../scripts/service-steps';

  initServiceSteps();
</script>
