---
/** Homepage hero: Johann's face mark with Figma-style Texture.
 *  Clip off + displace + blur + hard alpha threshold = crisp gooey melt,
 *  spill droplets, inner eyes/mouth kept filled. Source proportions (no
 *  horizontal stretch). Texture drifts via feOffset on pointer.
 *  Gradient via ?hero=gradient. */
---

<svg
  class="mark mark-blob"
  viewBox="0 0 559 249"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  data-hero-blob
  overflow="visible"
>
  <defs>
    <!--
      Eye-matched to mockup (no extra scaleX — source 559×249 as-is):
        1) low-freq displace → blur → discrete alpha = crisp gooey body
        2) high-freq / high-scale spill pass for tendrils + droplets
        3) oversized filter region (Clip OFF)
      feOffset: JS shifts noise field only (shape does not move/scale).
    -->
    <filter
      id="hero-blob-texture"
      x="-60%"
      y="-80%"
      width="220%"
      height="260%"
      filterUnits="objectBoundingBox"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.009"
        numOctaves="2"
        seed="41"
        result="noise"
      ></feTurbulence>
      <feOffset in="noise" dx="0" dy="0" result="shifted" data-blob-offset></feOffset>

      <!-- Body: chunky melt, strong blur → clean liquid edges -->
      <feDisplacementMap
        in="SourceGraphic"
        in2="shifted"
        scale="105"
        xChannelSelector="R"
        yChannelSelector="G"
        result="dispMain"
      ></feDisplacementMap>
      <feGaussianBlur in="dispMain" stdDeviation="4.5" result="blurMain"></feGaussianBlur>
      <feComponentTransfer in="blurMain" result="gooMain">
        <feFuncA type="discrete" tableValues="0 0 1 1 1 1 1"></feFuncA>
      </feComponentTransfer>

      <!-- Spill noise (higher freq) for thin strands / islands -->
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.035"
        numOctaves="2"
        seed="7"
        result="noiseSpill"
      ></feTurbulence>
      <feOffset in="noiseSpill" dx="0" dy="0" result="shiftedSpill" data-blob-offset-spill></feOffset>
      <feDisplacementMap
        in="SourceGraphic"
        in2="shiftedSpill"
        scale="48"
        xChannelSelector="R"
        yChannelSelector="G"
        result="dispSpill"
      ></feDisplacementMap>
      <feGaussianBlur in="dispSpill" stdDeviation="0.9" result="blurSpill"></feGaussianBlur>
      <feComponentTransfer in="blurSpill" result="gooSpill">
        <feFuncA type="discrete" tableValues="0 0 0 0 1 1 1"></feFuncA>
      </feComponentTransfer>

      <feMerge result="goo">
        <feMergeNode in="gooMain"></feMergeNode>
        <feMergeNode in="gooSpill"></feMergeNode>
      </feMerge>
      <feFlood flood-color="#B70606" result="red"></feFlood>
      <feComposite in="red" in2="goo" operator="in" result="flat"></feComposite>
      <feMerge>
        <feMergeNode in="flat"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  <g filter="url(#hero-blob-texture)">
    <path
      d="M279.042 0C433.153 -6.7364e-06 558.085 58.867 558.085 131.482C558.085 182.171 497.209 226.158 408.028 248.102V245.562C476.807 225.284 522.552 189.272 522.552 148.225C522.552 84.8558 413.529 33.4854 279.042 33.4854C144.555 33.4854 35.5312 84.8557 35.5312 148.225C35.5314 189.275 81.2831 225.289 150.07 245.566V248.104C60.8819 226.162 0.000283291 182.174 0 131.482C-3.17412e-06 58.8671 124.931 0.000104863 279.042 0Z"
      fill="#B70606"></path>
    <ellipse cx="153.872" cy="149.482" rx="84.8098" ry="60.171" fill="#B70606"></ellipse>
    <ellipse cx="404.224" cy="149.482" rx="84.8098" ry="60.171" fill="#B70606"></ellipse>
    <ellipse cx="280.484" cy="235.027" rx="78.7657" ry="10.0642" fill="#B70606"></ellipse>
    <!-- Far seeds → detached droplets after spill displace -->
    <circle cx="-20" cy="120" r="4" fill="#B70606"></circle>
    <circle cx="580" cy="130" r="3.5" fill="#B70606"></circle>
    <circle cx="60" cy="-15" r="3" fill="#B70606"></circle>
    <circle cx="500" cy="-12" r="3.2" fill="#B70606"></circle>
    <circle cx="120" cy="270" r="3" fill="#B70606"></circle>
    <circle cx="440" cy="275" r="3.4" fill="#B70606"></circle>
    <circle cx="280" cy="-25" r="2.5" fill="#B70606"></circle>
    <circle cx="-10" cy="220" r="2.8" fill="#B70606"></circle>
    <circle cx="570" cy="210" r="2.6" fill="#B70606"></circle>
  </g>
</svg>
