---
/** Homepage hero mark: little-man paths with a Figma-style Texture
 *  (feTurbulence + feDisplacementMap). Clip-to-shape is off so distress spills.
 *  Tuned by eye to Johann's mockup (Figma Texture 100/100/100 was a hint only;
 *  he also rescaled). Gradient Mark stays via ?hero=gradient. */
---

<svg
  class="mark mark-blob"
  viewBox="0 0 640 362"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  data-hero-blob
  overflow="visible"
>
  <defs>
    <!--
      Eye-matched to mockup: wide splat (~1.79), liquid lakes + bridges,
      melt edges, loose droplets. Flat #B70606.
      Resting scaleX baked into geometry so filter sees the final silhouette
      (CSS scaleX was shredding noise). Isotropic low-freq + strong displace.
      Oversized filter region = Clip to shape OFF.
      feOffset: JS drifts the noise field toward the pointer.
      Figma Size/Radius/Clip were hints only — numbers below are visual rescale.
    -->
    <filter
      id="hero-blob-texture"
      x="-22%"
      y="-40%"
      width="144%"
      height="180%"
      filterUnits="objectBoundingBox"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.0095"
        numOctaves="2"
        seed="19"
        result="noise"
      ></feTurbulence>
      <feOffset in="noise" dx="0" dy="0" result="shifted" data-blob-offset></feOffset>
      <feDisplacementMap
        in="SourceGraphic"
        in2="shifted"
        scale="148"
        xChannelSelector="R"
        yChannelSelector="G"
        result="displaced"
      ></feDisplacementMap>
      <feMerge>
        <feMergeNode in="displaced"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
  <g filter="url(#hero-blob-texture)">
    <g transform="translate(320 181) scale(3.7 1) translate(-85.5 -181)">
      <path d="M85.5 85.9893C132.72 85.9893 171 147.773 171 223.988C171 299.62 133.304 361.041 86.583 361.977C127.229 361.04 160 307.456 160 241.49C160 174.94 126.645 120.99 85.5 120.99C44.3548 120.99 11 174.94 11 241.49C11 307.455 43.7706 361.039 84.416 361.977C37.6952 361.04 9.65114e-07 299.619 0 223.988C0.000106323 147.773 38.2797 85.9894 85.5 85.9893Z" fill="#B70606" stroke="#B70606" stroke-width="26" stroke-linejoin="round"></path>
      <path d="M85 74.9883C97.7025 74.9882 108 58.199 108 37.4883C108 17.0629 97.9841 0.45381 85.5234 0C96.3272 0.451067 105 14.8234 105 32.4883C105 50.4375 96.0457 64.9883 85 64.9883C73.9543 64.9883 65 50.4375 65 32.4883C65 14.824 73.6723 0.451887 84.4756 0C72.0153 0.454514 62.0001 17.0634 62 37.4883C62 58.1991 72.2975 74.9883 85 74.9883Z" fill="#B70606" stroke="#B70606" stroke-width="10" stroke-linejoin="round"></path>
    </g>
  </g>
</svg>
