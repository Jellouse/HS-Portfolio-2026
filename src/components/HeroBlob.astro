---
interface Props {
  filterId?: string;
  home?: boolean;
  /** Small resting face. Cursor turbulence stays on the SVG filter. */
  mark?: boolean;
  /** The settled homepage mark: the same drawing, no turbulence. */
  settled?: boolean;
}

const { filterId = 'hero-blob-texture', home = true, mark = false, settled = false } = Astro.props;
const fill = 'currentColor';
const round = mark && !home;
const texture = !settled;
// The round face displaces by at most scale / 2 (50 units) plus three blur
// sigmas (7 units) past its 70 unit box, so its filter region stops at 85%
// out on each side. A larger region only adds pixels the browser filters.
const faceHead =
  'M34.6953 0C53.8571 0 69.3916 15.5855 69.3916 34.8105C69.3914 54.0354 53.857 69.6201 34.6953 69.6201C15.5338 69.6199 0.000238371 54.0353 0 34.8105C0 15.5856 15.5337 0.000210079 34.6953 0Z';
const faceMouth =
  'M34.9707 58.3516C29.4484 58.3516 24.9712 59.471 24.9707 60.8516C24.9715 62.2321 29.4486 63.3515 34.9707 63.3516C40.4931 63.3516 44.97 62.2321 44.9707 60.8516C44.9702 59.471 40.4932 58.3516 34.9707 58.3516Z';
const faceEyeL =
  'M18.4707 18.3516C12.672 18.3521 7.97078 26.187 7.9707 35.8516C7.97082 45.5161 12.672 53.351 18.4707 53.3516C24.2696 53.3516 28.9706 45.5164 28.9707 35.8516C28.9706 26.1867 24.2696 18.3516 18.4707 18.3516Z';
const faceEyeR =
  'M50.4707 18.3516C44.672 18.3521 39.9708 26.187 39.9707 35.8516C39.9708 45.5161 44.672 53.351 50.4707 53.3516C56.2696 53.3516 60.9706 45.5164 60.9707 35.8516C60.9706 26.1867 56.2696 18.3516 50.4707 18.3516Z';
const faceEvenodd = `${faceHead}${faceMouth}${faceEyeL}${faceEyeR}`;
---

<svg
  class:list={[home ? 'mark mark-blob' : round ? 'arrow-face-blob' : 'service-face', settled && round && 'is-face-settled']}
  viewBox={round ? '0 0 70 70' : '0 0 559 249'}
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  data-hero-blob={home || undefined}
  data-mark-face={mark || undefined}
  overflow="visible"
  preserveAspectRatio={round ? 'none' : undefined}
>
  {(texture || round) && (
    <defs>
      {texture && (
        <filter
          id={filterId}
          x={round ? '-85%' : '-45%'}
          y={round ? '-85%' : '-55%'}
          width={round ? '270%' : '190%'}
          height={round ? '270%' : '210%'}
          filterUnits="objectBoundingBox"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.015"
            numOctaves="2"
            seed="48"
            result="noise"
          ></feTurbulence>
          <feOffset in="noise" dx="0" dy="0" result="shifted" data-blob-offset></feOffset>
          <feDisplacementMap
            in="SourceGraphic"
            in2="shifted"
            scale={round ? '100' : '111'}
            xChannelSelector="R"
            yChannelSelector="G"
            result="displaced"
          ></feDisplacementMap>
          <feGaussianBlur in="displaced" stdDeviation="2.2" result="blurred"></feGaussianBlur>
          <feComponentTransfer in="blurred" result="goo">
            <feFuncA type="discrete" tableValues="0 0 1 1 1 1 1 1"></feFuncA>
          </feComponentTransfer>
          <feFlood flood-color={fill} result="red"></feFlood>
          <feComposite in="red" in2="goo" operator="in" result="flat"></feComposite>
          <feMerge>
            <feMergeNode in="flat"></feMergeNode>
          </feMerge>
        </filter>
      )}
      {round && (
        <clipPath id={`${filterId}-clip`}>
          <path d={faceHead}></path>
        </clipPath>
      )}
    </defs>
  )}
  {round ? (
    <>
      {/* Intro / GL source: evenodd holes. Hidden once the resting glance layer takes over. */}
      {!settled && (
        <g filter={texture ? `url(#${filterId})` : undefined}>
          <path fill-rule="evenodd" data-face-source d={faceEvenodd} fill={fill}></path>
        </g>
      )}
      {/* Resting face: solid head, fixed mouth, eyes that CSS can translate. */}
      <g data-face-glance-layer>
        <path d={faceHead} fill={fill}></path>
        <path data-face-mouth d={faceMouth}></path>
        <g clip-path={`url(#${filterId}-clip)`}>
          <g data-face-features>
            <path d={faceEyeL}></path>
            <path d={faceEyeR}></path>
          </g>
        </g>
      </g>
    </>
  ) : (
    <g filter={texture ? `url(#${filterId})` : undefined}>
      <path
        d="M279.042 0C433.153 -6.7364e-06 558.085 58.867 558.085 131.482C558.085 182.171 497.209 226.158 408.028 248.102V245.562C476.807 225.284 522.552 189.272 522.552 148.225C522.552 84.8558 413.529 33.4854 279.042 33.4854C144.555 33.4854 35.5312 84.8557 35.5312 148.225C35.5314 189.275 81.2831 225.289 150.07 245.566V248.104C60.8819 226.162 0.000283291 182.174 0 131.482C-3.17412e-06 58.8671 124.931 0.000104863 279.042 0Z"
        fill={fill}></path>
      <ellipse cx="153.872" cy="149.482" rx="84.8098" ry="60.171" fill={fill}></ellipse>
      <ellipse cx="404.224" cy="149.482" rx="84.8098" ry="60.171" fill={fill}></ellipse>
      <ellipse cx="280.484" cy="235.027" rx="78.7657" ry="10.0642" fill={fill}></ellipse>
    </g>
  )}
</svg>
