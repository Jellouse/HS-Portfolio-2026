---
import { paragraphs, renderInline } from '../lib/content';

interface Props {
  title: string;
  years?: string;
  summary?: string;
}

const { title, years, summary } = Astro.props;
const parts = summary && summary.trim() ? paragraphs(summary) : [];
---

<header class="project-hero">
  <h1>
    {title}{years ? <>, <span class="project-year">{years}</span></> : null}
  </h1>
  {parts.length > 0 && (
    <div class="summary project-summary">
      {parts.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
    </div>
  )}
</header>
