---
import { paragraphs } from '../lib/content';
import Prose from './sections/Prose.astro';

interface Props {
  title: string;
  years?: string;
  summary?: string;
}

const { title, years, summary } = Astro.props;
const parts = summary && summary.trim() ? paragraphs(summary) : [];
---

<header class="project-hero" data-no-reveal>
  <h1>
    <span class="project-title">{title}</span>{years ? <span class="project-year">{years}</span> : null}
  </h1>
  {parts.length > 0 && (
    <div class="summary project-summary">
      <Prose paragraphs={parts} />
    </div>
  )}
</header>
