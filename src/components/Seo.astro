---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  noindex?: boolean;
}

const { title, description, image, type = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image
  ? await getImage({
      src: image,
      width: Math.min(1200, image.width),
      height: Math.min(630, image.height),
      fit: 'cover',
      format: 'jpeg',
      quality: 75,
      background: '#ffffff',
    })
  : null;
// Homepage (and pages without a cover) share the animated blob-face GIF; frame 0 is the resting hero.
const useBlob = Astro.url.pathname === '/' || !og;
const ogUrl = useBlob ? new URL('/og/humansize-blob.gif', Astro.site).href : new URL(og!.src, Astro.site).href;
const ogW = useBlob ? 1200 : og!.attributes.width ?? Math.min(1200, image!.width);
const ogH = useBlob ? 630 : og!.attributes.height ?? Math.min(630, image!.height);
const ogType = useBlob ? 'image/gif' : 'image/jpeg';
const json = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\u003c')
  : '';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <link rel="canonical" href={canonical.href} />
)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:type" content={ogType} />
<meta property="og:image:width" content={String(ogW)} />
<meta property="og:image:height" content={String(ogH)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={title} />
{json && <script type="application/ld+json" set:html={json} />}
