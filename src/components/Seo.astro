---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  noindex?: boolean;
}

const { title, description, image, type = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image
  ? await getImage({
      src: image,
      width: Math.min(1200, image.width),
      height: Math.min(630, image.height),
      fit: 'cover',
      format: 'jpeg',
      quality: 75,
      background: '#ffffff',
    })
  : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
const json = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\u003c')
  : '';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <link rel="canonical" href={canonical.href} />
)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical.href} />
{ogUrl && <meta property="og:image" content={ogUrl} />}
<meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogUrl && <meta name="twitter:image" content={ogUrl} />}
{json && <script type="application/ld+json" set:html={json} />}
