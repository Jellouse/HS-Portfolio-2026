---
import Peeps from './Peeps.astro';
import { renderInline, type SiteData } from '../lib/content';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-copy">
    <div class="page-grid">
      <div class="footer-text fade-in">
        <p set:html={renderInline(site.intro)} />
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.studio}
        </p>
      </div>
    </div>
  </div>
  <div class="footer-faces" aria-hidden="true">
    <Peeps maxH={2} />
  </div>
</footer>
