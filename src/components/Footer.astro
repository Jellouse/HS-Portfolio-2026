---
import Peeps from './Peeps.astro';
import type { SiteData } from '../lib/content';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-text">
    <p>Humansize is the studio of Johann Schnettker.</p>
    <p>
      I design things you can look at, click through and walk into, like 3D renders and artwork,
      websites built in Framer, and retail spaces.
    </p>
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a><br />
      {site.studio}
    </p>
  </div>
  <div class="footer-faces">
    <Peeps maxH={2} />
  </div>
</footer>
