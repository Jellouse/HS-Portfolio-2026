---
import About from './About.astro';
import LeadCard from './LeadCard.astro';
import ProjectCard from './ProjectCard.astro';
import type { ProjectEntry } from '../lib/content';

interface Props {
  projects: ProjectEntry[];
  about: string[];
}

const { projects, about } = Astro.props;
---

<div class="feed page-grid">
  {/* About first so bio peeks under the hero; peeps lead card follows. */}
  <About paragraphs={about} />
  <LeadCard />
  {projects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}
</div>
