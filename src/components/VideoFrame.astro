---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster?: ImageMetadata | string;
  label?: string | null;
  plain?: boolean;
  flush?: boolean;
  outline?: boolean;
  priority?: boolean;
  fade?: boolean;
}

const { src, poster, label, plain = false, flush = false, outline = false, fade = true } = Astro.props;
let posterSrc: string | undefined;
if (typeof poster === 'string') {
  posterSrc = poster;
} else if (poster) {
  posterSrc = (
    await getImage({ src: poster, width: Math.min(poster.width, 2000), format: 'webp' })
  ).src;
}

const ext = src.toLowerCase().split(/[?#]/)[0].split('.').pop();
const type = ext === 'webm' ? 'video/webm' : ext === 'mov' ? 'video/quicktime' : 'video/mp4';
const mediaRatio = poster && typeof poster !== 'string' ? poster.width / poster.height : undefined;
---

<div class:list={['frame', 'is-video', { 'scroll-media': fade, 'is-plain': plain, 'is-flush': flush, 'is-outlined': outline }]} style={mediaRatio ? `--media-ratio:${mediaRatio}` : undefined}>
  <video
    muted
    loop
    playsinline
    preload="none"
    poster={posterSrc}
    aria-label={label || undefined}
    data-src={src}
    data-autoplay
  >
    <source type={type} />
  </video>
</div>
