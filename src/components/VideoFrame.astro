---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster?: ImageMetadata | string;
  label?: string | null;
  plain?: boolean;
  flush?: boolean;
  priority?: boolean;
}

const { src, poster, label, plain = false, flush = false, priority = false } = Astro.props;
let posterSrc: string | undefined;
const dims = poster && typeof poster !== 'string' ? { width: poster.width, height: poster.height } : {};
if (typeof poster === 'string') {
  posterSrc = poster;
} else if (poster) {
  posterSrc = (
    await getImage({ src: poster, width: Math.min(poster.width, 2000), format: 'webp' })
  ).src;
}
// local paths (/media/...) or full URLs (Cloudflare R2); ignore any query string
const ext = src.toLowerCase().split(/[?#]/)[0].split('.').pop();
const type = ext === 'webm' ? 'video/webm' : ext === 'mov' ? 'video/quicktime' : 'video/mp4';
---

<div class:list={['frame', 'is-video', { 'is-plain': plain, 'is-flush': flush }]}>
  <video
    muted
    autoplay
    loop
    playsinline
    preload={priority ? 'auto' : 'metadata'}
    poster={posterSrc}
    {...dims}
    aria-label={label || undefined}
    data-autoplay
  >
    <source src={src} type={type} />
  </video>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  function apply() {
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
      if (reduce.matches) {
        video.pause();
        video.currentTime = 0;
      } else {
        video.play().catch(() => {});
      }
    });
  }
  apply();
  reduce.addEventListener('change', apply);

  // Fade in once the first frame (or the poster) can be shown, never pop in.
  document.querySelectorAll<HTMLVideoElement>('.frame video').forEach((video) => {
    const ready = () => video.classList.add('is-ready');
    if (video.readyState >= 2) return ready();
    video.addEventListener('loadeddata', ready, { once: true });
    if (video.poster) {
      const img = new Image();
      img.onload = img.onerror = ready;
      img.src = video.poster;
    }
    setTimeout(ready, 4000); // never stays hidden
  });
</script>
