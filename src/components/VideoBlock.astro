---
import VideoFrame from './VideoFrame.astro';
import { resolveImageSource } from '../lib/images';

interface Props {
  src: string;
  poster?: string;
  label?: string;
  frame?: 'default' | 'wide';
  flush?: boolean;
  outline?: boolean;
  entry?: boolean;
}

const { src, poster, label, frame = 'default', flush = false, outline = false, entry = false } = Astro.props;
const posterImage = poster ? resolveImageSource(poster) : undefined;
---

<figure class:list={['image-block', 'video-block', 'fade-in', { 'is-entry': entry }]} data-frame={frame}>
  <VideoFrame src={src} poster={posterImage} label={label} flush={flush} outline={outline} />
</figure>
