---
import VideoFrame from './VideoFrame.astro';
import { resolveImageSource } from '../lib/images';

interface Props {
  src: string;
  poster?: string;
  label?: string;
  frame?: 'default' | 'wide';
  flush?: boolean;
  outline?: boolean;
}

const { src, poster, label, frame = 'default', flush = false, outline = false } = Astro.props;
const posterImage = poster ? resolveImageSource(poster) : undefined;
---

<figure class="image-block video-block fade-in" data-frame={frame}>
  <VideoFrame src={src} poster={posterImage} label={label} flush={flush} outline={outline} />
</figure>
