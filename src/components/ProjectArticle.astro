---
import Blocks from './Blocks.astro';
import MarkFace from './MarkFace.astro';
import ProjectHero from './ProjectHero.astro';
import { yearRange, type ProjectEntry } from '../lib/content';

interface Props {
  project: ProjectEntry;
  processFolderSrcs?: string[];
}

const { project, processFolderSrcs } = Astro.props;
const years = yearRange(project.data.year, project.data.yearEnd);
const info = (() => {
  const items = [...project.data.info];
  if (!years) return items;
  const at = items.findIndex((item) => item.label.trim().toLowerCase() === 'year');
  const line = { label: 'Year', value: years };
  if (at === -1) return [...items, line];
  return items
    .filter((item, i) => i === at || item.label.trim().toLowerCase() !== 'year')
    .map((item, i) => (i === at ? line : item));
})();
---

<article
  class:list={['project', 'page-grid', { 'is-plain': project.data.rounded === false }]}
  data-slug={project.id}
>
  <div class="project-mark" data-project-menu>
    <a href="/" aria-label="Humansize" data-project-face>
      <MarkFace />
    </a>
    <nav class="project-menu" aria-label="Main">
      <a href="/" style="--i: -1">Home</a>
      <a href="/shop" style="--i: 0">Shop</a>
      <button type="button" data-contact-open style="--i: 1">Contact</button>
    </nav>
  </div>
  <ProjectHero title={project.data.title} years={years} summary={project.data.summary} />
  <Blocks
    blocks={project.data.blocks}
    slug={project.id}
    processFromFolder={project.data.processFromFolder}
    processFolderSrcs={processFolderSrcs}
    info={info}
  />
</article>

<script>
  import { initProjectMenu } from '../scripts/project-menu';
  initProjectMenu();
</script>
