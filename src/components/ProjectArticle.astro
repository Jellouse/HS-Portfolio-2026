---
import Blocks from './Blocks.astro';
import ProjectHero from './ProjectHero.astro';
import { yearRange, type ProjectEntry } from '../lib/content';

interface Props {
  project: ProjectEntry;
  processFolderSrcs?: string[];
}

const { project, processFolderSrcs } = Astro.props;
const years = yearRange(project.data.year, project.data.yearEnd);
const info = (() => {
  const items = [...project.data.info];
  if (!years) return items;
  const at = items.findIndex((item) => item.label.trim().toLowerCase() === 'year');
  const line = { label: 'Year', value: years };
  if (at === -1) return [...items, line];
  return items
    .filter((item, i) => i === at || item.label.trim().toLowerCase() !== 'year')
    .map((item, i) => (i === at ? line : item));
})();
---

<article
  class:list={['project', 'page-grid', { 'is-plain': project.data.rounded === false }]}
  data-slug={project.id}
>
  <a class="arrow-back project-back" href="/" data-project-back aria-label="Back">
    <svg viewBox="0 0 21 20" aria-hidden="true">
      <path d="M2.11719 7H13.1172C16.4309 7 19.1172 9.68629 19.1172 13C19.1172 16.3137 16.4309 19 13.1172 19H5.98082" fill="none" stroke="currentColor" stroke-width="2"></path>
      <path d="M7.53027 13.2324L1.41406 7.11621L7.53027 0.999995" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </a>
  <ProjectHero title={project.data.title} years={years} summary={project.data.summary} />
  <Blocks
    blocks={project.data.blocks}
    slug={project.id}
    processFromFolder={project.data.processFromFolder}
    processFolderSrcs={processFolderSrcs}
    info={info}
  />
</article>

<script>
  const back = document.querySelector<HTMLAnchorElement>('[data-project-back]');
  if (back && !back.dataset.bound) {
    back.dataset.bound = 'true';
    const typing = (event: Event) =>
      event.target instanceof Element && !!event.target.closest('input, textarea, [contenteditable="true"]');
    const leaves = (key: string) => key === 'ArrowUp' || key === 'Escape' || key === 'Backspace';
    back.addEventListener('click', (event) => {
      if (sessionStorage.getItem('arrow-return') !== '1' || history.length < 2) return;
      sessionStorage.removeItem('arrow-return');
      event.preventDefault();
      history.back();
    });
    window.addEventListener('keydown', (event) => {
      if (event.metaKey || event.altKey || event.ctrlKey || event.repeat) return;
      if (typing(event) || !leaves(event.key)) return;
      if (document.documentElement.classList.contains('is-contact-open')) return;
      event.preventDefault();
      back.classList.add('is-pressed');
    });
    window.addEventListener('keyup', (event) => {
      if (!back.classList.contains('is-pressed') || !leaves(event.key)) return;
      back.classList.remove('is-pressed');
      back.click();
    });
  }
</script>
