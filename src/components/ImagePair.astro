---
import BlurImage from './BlurImage.astro';
import { resolveImageSource } from '../lib/images';

interface Props {
  left: string;
  leftAlt: string;
  right: string;
  rightAlt: string;
  leftPriority?: boolean;
  rightPriority?: boolean;
  large?: boolean;
}

const { left, leftAlt, right, rightAlt, leftPriority = false, rightPriority = false, large = false } = Astro.props;
---

<div class="pair fade-in" data-large={large ? '' : undefined}>
  <BlurImage
    src={resolveImageSource(left)}
    alt={leftAlt}
    priority={leftPriority}
    sizes="(min-width: 760px) 552px, calc(100vw - 40px)"
  />
  <BlurImage
    src={resolveImageSource(right)}
    alt={rightAlt}
    priority={rightPriority}
    sizes="(min-width: 760px) 552px, calc(100vw - 40px)"
  />
</div>
