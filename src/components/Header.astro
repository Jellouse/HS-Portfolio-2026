---
import type { SiteData } from '../lib/content';
import MainMenu from './sections/MainMenu.astro';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
const socials = [...site.socials.filter((s) => s.href), { label: 'Email', href: `mailto:${site.email}` }];
const home = Astro.url.pathname === '/';
---

<header class="site-header">
  <p class="brand">
    <button type="button" class="brand-toggle" aria-expanded="false" aria-controls="site-socials" data-socials-toggle>
      <span class="brand-stack"><span class="brand-word"><span class="brand-shift"><span class="brand-at" aria-hidden="true">@</span><span class="brand-name">Humansize</span></span><span class="brand-pad" aria-hidden="true">Humansize</span></span></span>
    </button>
  </p>
  <MainMenu variant="header" home={home} />
  <nav class="site-menu site-socials" id="site-socials" aria-label="Socials" data-socials data-intro-copy hidden>
    {socials.map((s) => (
      <a href={s.href} {...(s.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' })}>{s.label}</a>
    ))}
  </nav>
</header>

<script>
  import { initSocials } from '../scripts/socials';
  import { scrollToId } from '../scripts/scroll-to-id';
  initSocials();
  document.querySelector('[data-about-link]')?.addEventListener('click', (e) => {
    if (!document.getElementById('about')) return;
    e.preventDefault();
    const about = scrollToId('about');
    if (!about) return;
    if (!about.hasAttribute('tabindex')) about.setAttribute('tabindex', '-1');
    about.focus({ preventScroll: true });
  });
</script>
