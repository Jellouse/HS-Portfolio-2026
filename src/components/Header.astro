---
import type { SiteData } from '../lib/content';

interface Props {
  site: SiteData;
}

// Homepage name block: "Humansize" (no hover state) over About / Shop / Contact (Home off the homepage). Items start gray, the
// hovered one turns black. Contact opens the contact sheet (ContactSheet.astro).
Astro.props;
const home = Astro.url.pathname === '/';
---

<a class="skip" href="#content">Skip to content</a>

<header class="site-header">
  <p class="brand">Humansize</p>
  <nav class="site-menu" aria-label="Main">
    {home ? <a href="#about" data-about-link>About</a> : <a href="/">Home</a>}
    <a href="/shop">Shop</a>
    <button type="button" data-contact-open>Contact</button>
  </nav>
</header>

<script>
  // About: smooth-scroll to the about text (respects reduced motion).
  document.querySelector('[data-about-link]')?.addEventListener('click', (e) => {
    const about = document.getElementById('about');
    if (!about) return;
    e.preventDefault();
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    // desktop: land about 100px above the text; phones: right at it
    const offset = matchMedia('(min-width: 760px)').matches ? 100 : 0;
    scrollTo({ top: Math.max(0, about.getBoundingClientRect().top + scrollY - offset), behavior: smooth ? 'smooth' : 'auto' });
    // keyboard users land in the about text too
    if (!about.hasAttribute('tabindex')) about.setAttribute('tabindex', '-1');
    about.focus({ preventScroll: true });
  });
</script>
