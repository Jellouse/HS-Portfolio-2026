---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import type { ProjectEntry } from '../lib/content';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<div class="grid-view" id="project-grid">
  <h2 class="sr-only">Projects</h2>
  <div class="grid-list">
    {
      projects.map((project) => {
        if (!project.data.cover || !project.data.coverAlt) return null;
        const image = resolveImage(project.data.cover);
        const widths = [400, 800].filter((width) => width < image.width);
        return (
          <a href={`/work/${project.id}`}>
            <Image
              src={image}
              alt={project.data.coverAlt}
              widths={widths.length ? widths : [image.width]}
              sizes="(min-width: 760px) 360px, 50vw"
              loading="lazy"
            />
            <span>{project.data.caption}</span>
          </a>
        );
      })
    }
  </div>
</div>
