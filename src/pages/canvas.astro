---
// Live design board: every page as a live iframe at 1440 and 390. Open in dev and on Vercel
// previews; on production only for GitHub users with push access to the repo (Keystatic's
// GitHub session, verified server-side). ?compare=<host1>,<host2> adds other hosts.
export const prerender = false;

import { getProjects, projectLabel } from '../lib/content';
import { canvasMode } from '../lib/canvas-env.mjs';
import { checkCanvasAccess, RETURN_COOKIE, TOKEN_COOKIE } from '../lib/canvas-auth.mjs';

const NOINDEX = { 'X-Robots-Tag': 'noindex, nofollow', 'Cache-Control': 'private, no-store' };
const mode = canvasMode({ ...process.env, NODE_ENV: import.meta.env.DEV ? 'development' : 'production' });
if (mode === 'auth') {
  const access = await checkCanvasAccess(Astro.cookies.get(TOKEN_COOKIE)?.value);
  if (access.status !== 'ok') {
    const forbidden = access.status === 'forbidden';
    if (!forbidden) {
      Astro.cookies.set(RETURN_COOKIE, '1', { path: '/', maxAge: 600, httpOnly: true, secure: true, sameSite: 'lax' });
    }
    const msg = forbidden
      ? `Signed in as ${access.login.replace(/[^\w-]/g, '')}, which has no push access to the site repo.`
      : 'The canvas is for site editors. Sign in with the GitHub account you use for Keystatic.';
    const html = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>Canvas · Humansize</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#1a1a1a;color:#8a8a8a;font:14px/20px ui-monospace,Menlo,monospace}main{max-width:360px;padding:20px}a{display:inline-block;margin-top:16px;padding:8px 12px;border-radius:4px;background:#fff;color:#000;text-decoration:none}</style></head><body><main><p>${msg}</p><a href="/api/keystatic/github/login">Sign in with GitHub</a></main></body></html>`;
    return new Response(html, {
      status: forbidden ? 403 : 401,
      headers: { ...NOINDEX, 'Content-Type': 'text/html; charset=utf-8' },
    });
  }
}
Astro.response.headers.set('X-Robots-Tag', NOINDEX['X-Robots-Tag']);
Astro.response.headers.set('Cache-Control', NOINDEX['Cache-Control']);

const projects = await getProjects();
const pages = [
  { name: 'Home', path: '/' },
  ...projects.map((p) => ({ name: projectLabel(p.data), path: `/work/${p.id}/` })),
  { name: '404', path: '/404' },
];
const widths = [
  { w: 1440, vh: 900 },
  { w: 390, vh: 844 },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Canvas · Humansize</title>
    <style is:global>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #1a1a1a; }
      body { font: 12px/16px ui-monospace, SFMono-Regular, Menlo, monospace; color: #8a8a8a; }
      #board { position: absolute; inset: 0; cursor: default; touch-action: none; }
      #board.is-panning, body.space #board { cursor: grab; }
      #board.is-panning { cursor: grabbing; }
      #world { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
      .frame { position: absolute; }
      .frame-label { position: absolute; left: 0; bottom: 100%; padding-bottom: 8px; white-space: nowrap; color: #8a8a8a; text-decoration: none; font-size: 12px; line-height: 16px; }
      .frame-label:hover { color: #fff; }
      .frame-box { background: #fff; overflow: hidden; }
      .frame-box iframe { display: block; border: 0; width: 100%; height: 100%; background: #fff; }
      .group-label { position: absolute; color: #fff; font-size: 16px; line-height: 20px; white-space: nowrap; }
      /* Frames ignore the pointer so the board always pans and zooms. Interact mode
         (button / I, or hold Alt/Option) hands the pointer to the frames; Esc turns it off. */
      .frame-box iframe { pointer-events: none; }
      body.interact .frame-box iframe, body.alt .frame-box iframe { pointer-events: auto; }
      body.interact .frame-box, body.alt .frame-box { outline: 1px solid rgba(76, 141, 255, 0.6); outline-offset: 2px; }
      .is-panning iframe, body.space iframe, body.pinch iframe { pointer-events: none !important; }
      #interact { font: inherit; border: 0; cursor: pointer; position: fixed; left: 16px; bottom: 16px; padding: 4px 8px; border-radius: 4px; background: #000; color: #8a8a8a; font-size: 12px; line-height: 16px; user-select: none; }
      body.interact #interact { color: #fff; }
      astro-dev-toolbar { display: none !important; }
      #zoom { position: fixed; right: 16px; bottom: 16px; padding: 4px 8px; border-radius: 4px; background: #000; color: #fff; font-size: 12px; line-height: 16px; user-select: none; }
    </style>
  </head>
  <body>
    <div id="board"><div id="world"></div></div>
    <div id="zoom">100%</div>
    <button id="interact" type="button" aria-pressed="false">Interact: off (I, or hold ⌥)</button>
    <script id="canvas-data" type="application/json" set:html={JSON.stringify({ pages, widths })} />
    <script>
      import { mountCanvas } from '../scripts/canvas';
      mountCanvas();
    </script>
  </body>
</html>
