---
export const prerender = true;
import '../../styles/global.css';
const base = [1, 1, 1, 1, 1, 1, 1, 1, 1];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Faces lab · Humansize</title>
</head>
<body class="lab">
  <main class="stage" id="stage">
    <div class="row" id="row">
      {base.map((s) => (
        <svg class="face" data-base={s} viewBox="0 0 122 180" preserveAspectRatio="none" aria-hidden="true">
          <g class="g">
            <path d="M60.9844 0C94.665 2.50437e-05 121.969 40.5453 121.969 90.5605C121.969 134.795 100.612 171.621 72.375 179.543V179.323C96.0654 171.722 113.794 140.903 113.794 104.04C113.794 61.4697 90.1516 26.9594 60.9873 26.959C31.8228 26.959 8.17983 61.4695 8.17969 104.04C8.17969 140.901 25.9058 171.717 49.5938 179.321V179.543C21.3571 171.621 6.24157e-07 134.795 0 90.5605C9.09239e-05 40.5453 27.3037 4.56074e-06 60.9844 0Z"/>
            <g class="feat">
            <ellipse cx="34.0536" cy="106.354" rx="18.2489" ry="41.324"/>
            <ellipse cx="87.9208" cy="106.354" rx="18.2489" ry="41.324"/>
            <ellipse cx="61.2954" cy="165.106" rx="15.2954" ry="6.91183"/>
            </g>
          </g>
        </svg>
      ))}
    </div>
  </main>
  <aside class="panel">
    <div class="modes" role="tablist">
      <button data-mode="focus">Focus</button>
      <button data-mode="wave">Wave</button>
      <button data-mode="tilt" class="on">Tilt</button>
      <button data-mode="look">Look</button>
      <button data-mode="split">Split</button>
    </div>
    <div id="dials"></div>
    <button id="copy" class="copy">Copy settings as JSON</button>
    <p class="note" id="note"></p>
  </aside>
  <style is:global>
    body.lab { margin: 0; background: var(--red); color: #f8f8f8; overflow: hidden; }
    .stage { height: 100vh; display: flex; align-items: center; }
    .row { display: flex; align-items: center; width: 100%; height: 70vh; padding: 0 16px; box-sizing: border-box; }
    .face { flex: 1 1 0; min-width: 0; height: 40%; display: block; overflow: visible; fill: #f8f8f8; }
    .face .feat { transform-box: view-box; }
    .panel { position: fixed; right: 16px; bottom: 16px; width: 260px; padding: 16px; border-radius: 15px;
      background: rgba(248,248,248,.96); color: #000; font-size: 13px; line-height: 18px; }
    .modes { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 12px; }
    .panel button { font: inherit; border: 0; border-radius: 999px; padding: 6px 10px; background: #e6e6e6; color: #000; cursor: pointer; }
    .panel button.on { background: #000; color: #fff; }
    .panel label { display: block; margin-bottom: 8px; }
    .panel label span { display: flex; justify-content: space-between; color: rgba(0,0,0,.6); }
    .panel input { width: 100%; accent-color: #b70606; }
    .copy { width: 100%; margin-top: 4px; }
    .note { margin: 8px 0 0; color: rgba(0,0,0,.4); font-size: 11px; line-height: 15px; }
  </style>
  <script is:inline>
  (() => {
    const rnd = (i, k) => { const x = Math.sin(i * 127.1 + k * 311.7) * 43758.5453; return x - Math.floor(x); };
    // soft clamp in log space: k = 0 is a hard clamp, larger k eases in earlier and gentler
    const sp = (z, k) => k <= 1e-4 ? Math.max(0, z) : (z / k > 30 ? z : k * Math.log1p(Math.exp(z / k)));
    const soft = (x, lo, hi, k) => { hi = Math.max(lo, hi); const a = Math.log(lo), b = Math.log(hi), y = Math.log(x);
      const r = b - sp(b - (a + sp(y - a, k)), k); return Math.exp(Math.max(a, Math.min(b, r))); };
    const ALL = ['focus','wave','tilt','look','split'];
    const D = {
      stretch: { label: 'Width stretch', min: 0, max: 4, step: .05, v: 3.45, modes: ALL },
      height: { label: 'Height stretch', min: 0, max: 2, step: .05, v: 1.7, modes: ALL },
      radius: { label: 'Radius (faces)', min: .3, max: 6, step: .1, v: 1.5, modes: ['focus','look'] },
      sharpness: { label: 'Sharpness', min: .5, max: 6, step: .1, v: 2, modes: ['focus','look','split'] },
      wavelength: { label: 'Wave length (faces)', min: 1, max: 14, step: .5, v: 4, modes: ['wave'] },
      eyes: { label: 'Eye shift', min: 0, max: 30, step: 1, v: 14, modes: ['look'] },
      minW: { label: 'Min width (x base)', min: .05, max: 1, step: .05, v: 0.4, modes: ALL },
      maxW: { label: 'Max width (x base)', min: 1, max: 9, step: .1, v: 1.2, modes: ALL },
      minH: { label: 'Min height (x base)', min: .1, max: 1, step: .05, v: 0.2, modes: ALL },
      maxH: { label: 'Max height (x base)', min: 1, max: 4, step: .1, v: 2.6, modes: ALL },
      softness: { label: 'Softness', min: 0, max: 1, step: .01, v: .35, modes: ALL },
      independence: { label: 'Independence', min: 0, max: 1, step: .01, v: 0.76, modes: ALL },
      randomness: { label: 'Randomness', min: 0, max: 1, step: .01, v: 0.5, modes: ALL },
      speed: { label: 'Idle speed', min: .1, max: 3, step: .05, v: 0.2, modes: ALL },
    };
    const S = Object.fromEntries(Object.entries(D).map(([k, d]) => [k, d.v]));
    let mode = 'tilt';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const row = document.getElementById('row');
    const faces = [...document.querySelectorAll('.face')].map((el, i) => ({ el, ft: el.querySelector('.feat'), i, seed: Math.random() * 100,
      ph: rnd(i, 1) * 2 - 1, gain: .3 + rnd(i, 2) * 1.7, dir: rnd(i, 3) * 2 - 1, hdir: rnd(i, 4) * 2 - 1 }));
    const N = faces.length;
    const dials = document.getElementById('dials'), note = document.getElementById('note');
    function render() {
      dials.innerHTML = '';
      for (const [k, d] of Object.entries(D)) {
        if (!d.modes.includes(mode)) continue;
        const l = document.createElement('label');
        l.innerHTML = `<span>${d.label}<b>${S[k]}</b></span><input type="range" min="${d.min}" max="${d.max}" step="${d.step}" value="${S[k]}">`;
        const inp = l.querySelector('input'), b = l.querySelector('b');
        inp.oninput = () => { S[k] = +inp.value; b.textContent = inp.value; if (reduce.matches) draw(.5, .5, 0); };
        dials.appendChild(l);
      }
      note.textContent = reduce.matches ? 'Reduced motion is on, so faces hold a still layout.'
        : fine.matches ? 'Move the cursor across the faces.' : 'No cursor, so a simulated one drives the faces.';
    }
    document.querySelectorAll('[data-mode]').forEach((b) => b.onclick = () => {
      mode = b.dataset.mode;
      document.querySelectorAll('[data-mode]').forEach((x) => x.classList.toggle('on', x === b));
      render(); if (reduce.matches) draw(.5, .5, 0);
    });
    document.getElementById('copy').onclick = async (e) => {
      const out = { mode };
      for (const k in D) if (D[k].modes.includes(mode)) out[k] = S[k];
      try { await navigator.clipboard.writeText(JSON.stringify(out, null, 2)); e.target.textContent = 'Copied'; }
      catch { prompt('Settings', JSON.stringify(out)); }
      setTimeout(() => e.target.textContent = 'Copy settings as JSON', 1200);
    };
    let px = 0, py = 0, last = -1e9;
    addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { px = e.clientX; py = e.clientY; last = performance.now(); } });
    const noise = (s, t) => Math.sin(t * 1.3 + s) * .6 + Math.sin(t * 2.7 + s * 1.7) * .4;
    // pure function: (u, v in 0..1 across the row, t) -> widths (flex shares) and heights
    function draw(u0, v0, t) {
      const I = S.independence;
      for (const f of faces) {
        // per-face seeded offset of phase (cursor position seen by this face), gain and direction
        const u = u0 + I * f.ph * .35, v = v0 + I * f.ph * .25;
        const cx = u * N - .5;
        const j = S.randomness * noise(f.seed, t);
        let lw = 0, h = 0, ex = 0, ey = 0;
        const d = Math.abs(f.i - cx);
        if (mode === 'focus' || mode === 'look') {
          const k = Math.exp(-Math.pow(d / S.radius, S.sharpness));
          lw = S.stretch * k; h = S.height * (k - .3) * (1 - v * 2) ;
          if (mode === 'look') {
            const fxp = (f.i + .5) / N, dx = u - fxp, dy = v - .5, m = Math.hypot(dx, dy) || 1;
            ex = dx / m * S.eyes * Math.min(1, m * 4); ey = dy / m * S.eyes * .7 * Math.min(1, m * 4);
          }
        } else if (mode === 'wave') {
          const w = Math.sin((f.i / S.wavelength) * Math.PI * 2 - u * Math.PI * 4);
          lw = S.stretch * w * .8; h = -S.height * w * (v - .5) * 2;
        } else if (mode === 'tilt') {
          const x = f.i / (N - 1) - .5;
          lw = S.stretch * x * (u - .5) * 4; h = S.height * x * (v - .5) * 4;
        } else {
          // split: faces left of cursor share one side, right the other; cursor x sets the split ratio
          const side = f.i < cx ? (cx + .5) / N : 1 - (cx + .5) / N;
          const k = Math.pow(Math.max(.02, side), S.sharpness);
          lw = S.stretch * Math.log(k + .01) * -.3 * (f.i < cx ? -1 : 1); h = S.height * (f.i % 2 ? 1 : -1) * (v - .5) * 2;
        }
        lw *= (1 + I * (f.gain - 1)) * (1 - I + I * f.dir);
        h *= (1 + I * (f.gain - 1)) * (1 - I + I * f.hdir);
        f.w = Math.exp(lw + j * .5);
        const hm = soft(Math.exp(h + j * .2), S.minH, S.maxH, S.softness);
        f.el.style.height = (40 * hm).toFixed(3) + '%';
        f.ft.style.transform = ex || ey ? `translate(${ex.toFixed(2)}px, ${ey.toFixed(2)}px)` : '';
      }
      // widths as multiples of base width (row / N): find one scale so the soft-clamped widths sum to N
      let a = -12, b = 12, ws = [];
      const total = (ls) => { ws = faces.map((f) => soft(f.w * Math.exp(ls), S.minW, S.maxW, S.softness)); return ws.reduce((x, y) => x + y, 0); };
      for (let it = 0; it < 40; it++) { const m = (a + b) / 2; if (total(m) < N) a = m; else b = m; }
      total((a + b) / 2);
      faces.forEach((f, k) => { f.el.style.flexGrow = ws[k].toFixed(4); }); // flex rescales to fit if limits are infeasible
    }
    function frame(now) {
      if (!reduce.matches) {
        const t = now / 1000 * S.speed, r = row.getBoundingClientRect();
        let u, v;
        if (fine.matches && now - last < 2500) { u = (px - r.left) / r.width; v = (py - r.top) / r.height; }
        else { u = .5 + .48 * Math.sin(t * .5) * Math.cos(t * .17); v = .5 + .4 * Math.sin(t * .37 + 1); }
        draw(Math.max(0, Math.min(1, u)), Math.max(0, Math.min(1, v)), t);
      }
      requestAnimationFrame(frame);
    }
    reduce.addEventListener('change', () => { render(); draw(.5, .5, 0); });
    render(); draw(.5, .5, 0);
    requestAnimationFrame(frame);
  })();
  </script>
</body>
</html>
