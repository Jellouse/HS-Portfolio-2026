---
import { projectLabel } from '../../lib/content';
export const prerender = true;

import ProjectArticle from '../../components/ProjectArticle.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, getProjects, plainText, type ProjectEntry } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import { projectJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const summary = plainText(project.data.summary);
const image = project.data.cover ? resolveImage(project.data.cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, `/work/${project.id}`);
const title = `${projectLabel(project.data)} · Humansize`;
---

<Base
  title={title}
  description={summary}
  image={image}
  type="article"
  jsonLd={projectJsonLd(project, pageUrl)}
>
  <ProjectArticle project={project} />
</Base>
