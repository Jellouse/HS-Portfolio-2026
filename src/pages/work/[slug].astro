---
import { projectLabel } from '../../lib/content';
export const prerender = true;

import ProjectArticle from '../../components/ProjectArticle.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, getProjects, plainText, type ProjectEntry } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import { projectJsonLd } from '../../lib/seo';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const summary = project.data.seoDescription?.trim() || plainText(project.data.summary);
const image = project.data.cover ? resolveImage(project.data.cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, `/work/${project.id}/`);
const service = (await getCollection('services')).find((s) => s.data.projects.includes(project.id));
const title = `${project.data.seoTitle?.trim() || projectLabel(project.data)} · Humansize`;
---

<Base
  title={title}
  description={summary}
  image={image}
  type="article"
  jsonLd={projectJsonLd(project, pageUrl)}
>
  <ProjectArticle project={project} />
  {service && <p class="project-service">Part of <a href={`/services/${service.id}/`}>{service.data.title}</a>.</p>}
</Base>
