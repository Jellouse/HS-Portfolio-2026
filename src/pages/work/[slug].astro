---
import Blocks from '../../components/Blocks.astro';
import Credits from '../../components/Credits.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, getProjects, type ProjectEntry } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import { projectJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const summary = project.data.summary.replace(/\s+/g, ' ').trim();
const image = project.data.cover ? resolveImage(project.data.cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, `/work/${project.id}`);
const title = `${project.data.caption} · Humansize`;
---

<Base
  title={title}
  description={summary}
  image={image}
  type="article"
  jsonLd={projectJsonLd(project, pageUrl)}
>
  <article class:list={['project', { 'is-plain': project.data.rounded === false }]} data-slug={project.id}>
    <ProjectHero title={project.data.caption} />
    <Blocks blocks={project.data.blocks} />
    <Credits items={project.data.credits} />
  </article>
</Base>
