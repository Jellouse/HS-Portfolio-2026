---
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, getProjects, getSite } from '../../lib/content';
import { resolveImage } from '../../lib/images';

const site = await getSite();
const projects = await getProjects();
const cover = projects[0]?.data.cover;
const image = cover ? resolveImage(cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, '/work');
const description = 'Projects by Johann Schnettker, Humansize.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Projects',
  url: pageUrl,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: project.data.listCaption || project.data.caption,
    url: absoluteUrl(Astro.site, `/work/${project.id}`),
  })),
};
---

<Base title={`Projects · ${site.studio}`} description={description} image={image} jsonLd={jsonLd}>
  <h1 class="sr-only">Projects</h1>
  <div class="overview">
    {projects.map((project, index) => <ProjectCard project={project} priority={index === 0} overview />)}
  </div>
</Base>
