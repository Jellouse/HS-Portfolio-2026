---
export const prerender = true;

import ArrowNav from '../../components/ArrowNav.astro';
import Base from '../../layouts/Base.astro';
import { getShopNav } from '../../lib/arrow-nav';
import { absoluteUrl } from '../../lib/content';

const tree = await getShopNav();
const shop = tree.nodes[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Industrial Bloom shop',
  url: absoluteUrl(Astro.site, '/shop/'),
  itemListElement: shop.slides.map((slide, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: slide.title,
    url: absoluteUrl(Astro.site, slide.href),
  })),
};
---

<Base
  jsonLd={jsonLd}
  title="Industrial Bloom shop · Humansize"
  description="Industrial Bloom: solid aluminium vases made from extrusion profiles, handmade in Germany in small numbered editions."
  hideFooter
>
  <ArrowNav tree={tree} startScreen="shop" backHref="/" />
</Base>
