---
export const prerender = true;

import BlurImage from '../../components/BlurImage.astro';
import Base from '../../layouts/Base.astro';
import mark from '../../assets/industrial-bloom-mark.svg?raw';
import { resolveImageSource } from '../../lib/images';
import { getProducts, price, shopUrl } from '../../lib/shop';

const products = (await getProducts()).filter((p) => p.data.overview.show !== false);
const sizes = '(min-width: 1440px) 439px, (min-width: 760px) 30vw, calc(50vw - 30px)';
---

<Base title="Industrial Bloom shop · Humansize" description="Industrial Bloom vases by Humansize." noindex>
  <div class="shop-page page-grid">
    <header class="shop-head">
      <h1 class="shop-head-title">Industrial Bloom</h1>
      <div class="shop-mark" role="img" aria-label="Industrial Bloom mark" set:html={mark} />
      <p class="shop-head-sub">Aluminium Vases</p>
    </header>

    <section class="shop-intro fade-in" aria-label="About Industrial Bloom">
      <p>
        Industrial Bloom is a range of solid aluminium vases. The name is a play on "industrial boom". Each vase is made
        from aluminium extrusion, a heavy-duty building material, and brings it into the home to hold something as
        delicate as flowers.
      </p>
      <p>They come in several sizes and are made and shipped from Europe. They're heavy and solid. If one falls, it won't break.</p>
      <p>To see how they're made, visit the <a href="/work/industrial-bloom/">Industrial Bloom</a> project page.</p>
    </section>

    {
      products.map((p, i) => {
        const o = p.data.overview;
        const left = o.left?.src ? o.left : p.data.images[0];
        const right = o.right?.src ? o.right : p.data.images[1];
        return (
          <section class="shop-product" aria-label={p.data.name}>
            <div class="shop-pair fade-in">
              {left?.src && <BlurImage src={resolveImageSource(left.src)} alt={left.alt} sizes={sizes} priority={i === 0} />}
              {right?.src && <BlurImage src={resolveImageSource(right.src)} alt={right.alt} sizes={sizes} priority={i === 0} />}
            </div>
            <p class="shop-caption fade-in">
              {o.title || p.data.name}
              <br />
              {o.price || price(p.data.price)}
              <span class="shop-links">
                <a href={`/shop/${p.id}/`}>Details</a>, <a href={shopUrl(p.id)}>Buy</a>
              </span>
            </p>
            {o.description && <p class="shop-desc fade-in">{o.description}</p>}
          </section>
        );
      })
    }
  </div>
</Base>
