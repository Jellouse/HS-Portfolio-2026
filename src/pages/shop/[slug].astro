---
export const prerender = true;

import ShopBuyBar from '../../components/sections/ShopBuyBar.astro';
import ShopCopy from '../../components/sections/ShopCopy.astro';
import ShopDetailHead from '../../components/sections/ShopDetailHead.astro';
import ShopDetailSection from '../../components/sections/ShopDetailSection.astro';
import ShopFigure from '../../components/sections/ShopFigure.astro';
import ShopInfo from '../../components/sections/ShopInfo.astro';
import ShopWild from '../../components/sections/ShopWild.astro';
import Base from '../../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { resolveImageSource } from '../../lib/images';
import { getProducts, priceText, seedEur, SHIPPING, type ProductEntry } from '../../lib/shop';
import { productJsonLd } from '../../lib/shop/jsonld';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: ProductEntry;
}

const { product } = Astro.props;
const d = product.data;
const detail = d.detail;
const title = detail.title || d.overview.title || d.name;
const eur = seedEur(product.id);
const intro = detail.description || d.description;
const images = detail.images;
const info = [
  ...detail.info,
  ...(eur == null ? [] : [{ label: 'Price', value: priceText(eur, 'prefix'), priceSlug: product.id }]),
  { label: 'Shipping', value: SHIPPING },
];

const site = Astro.site!;
const imageUrls = await Promise.all(
  images.map(async (i) => {
    const src = resolveImageSource(i.src);
    if (typeof src === 'string') return new URL(src, site).href;
    return new URL((await getImage({ src, width: Math.min(1200, src.width), format: 'jpeg', quality: 80 })).src, site).href;
  }),
);
const jsonLd = await productJsonLd({
  slug: product.id,
  name: title,
  description: d.seo.description || d.description,
  url: new URL(`/shop/${product.id}/`, site).href,
  images: imageUrls,
  eur,
});
const big = '(min-width: 760px) calc(5 * var(--col) + 4 * var(--gutter)), calc(100vw - 40px)';
const half = '(min-width: 760px) 272px, calc((100vw - 48px) / 2)';
---

<Base
  title={d.seo.title || `${d.name} · Industrial Bloom · Humansize`}
  description={d.seo.description || d.description}
  jsonLd={jsonLd}
>
  <article class="shop-detail page-grid" data-slug={product.id}>
    <a class="arrow-back project-back" href="/#shop" data-project-back aria-label="Back">
      <svg viewBox="0 0 21 20" aria-hidden="true">
        <path d="M2.11719 7H13.1172C16.4309 7 19.1172 9.68629 19.1172 13C19.1172 16.3137 16.4309 19 13.1172 19H5.98082" fill="none" stroke="currentColor" stroke-width="2"></path>
        <path d="M7.53027 13.2324L1.41406 7.11621L7.53027 0.999995" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </a>
    <ShopDetailHead title={title} slug={product.id} eur={eur} />
    <ShopCopy text={intro} />
    {images.map((img, i) => (
      <ShopFigure src={img.src} alt={img.alt} outline={img.outline === true} sizes={big} priority={i < 1} />
    ))}
    {detail.sections.map((section) => (
      <ShopDetailSection heading={section.heading} text={section.text} image={section.image} sizes={big} />
    ))}
    {detail.wild.length > 0 && <ShopWild title={detail.wildTitle} images={detail.wild} sizes={half} />}
    <ShopInfo items={info} />
    <ShopBuyBar slug={product.id} />
  </article>
</Base>

<script>
  import { applyStock } from '../../lib/shop/label.mjs';
  import { initProjectBack } from '../../scripts/project-back';
  import { applyPrices, showBuyNote } from '../../scripts/shop-price';
  initProjectBack();
  showBuyNote();

  const refreshBuy = async () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-buy]');
    if (!btn) return;
    try {
      const res = await fetch('/api/shop/stock', { signal: AbortSignal.timeout(4000) });
      const data = res.ok ? await res.json() : null;
      applyStock(btn, btn.dataset.buy!, data);
      applyPrices(data);
    } catch {
      applyStock(btn, btn.dataset.buy!, null);
    }
  };
  refreshBuy();
  addEventListener('pageshow', (e) => {
    if (e.persisted) refreshBuy();
  });
</script>
