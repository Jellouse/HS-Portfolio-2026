---
export const prerender = true;

import mark from '../../assets/industrial-bloom-mark.svg?raw';
import BlurImage from '../../components/BlurImage.astro';
import SmallMenu from '../../components/SmallMenu.astro';
import Info from '../../components/Info.astro';
import Base from '../../layouts/Base.astro';
import { paragraphs, renderInline } from '../../lib/content';
import { resolveImageSource } from '../../lib/images';
import { getImage } from 'astro:assets';
import { getProducts, priceText, seedEur, SHIPPING, type ProductEntry } from '../../lib/shop';
import { productJsonLd } from '../../lib/shop/jsonld';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: ProductEntry;
}

const { product } = Astro.props;
const d = product.data;
const detail = d.detail;
const title = detail.title || d.overview.title || d.name;
const eur = seedEur(product.id);
const intro = paragraphs(detail.description || d.description);
const images = detail.images;
const info = [
  ...detail.info,
  ...(eur == null ? [] : [{ label: 'Price', value: priceText(eur, 'prefix'), priceSlug: product.id }]),
  { label: 'Shipping', value: SHIPPING },
];

const packshot = images.find((i) => /packshot/i.test(i.alt)) ?? images[0];
const packshotSrc = packshot ? resolveImageSource(packshot.src) : undefined;
const ogImage = packshotSrc && typeof packshotSrc !== 'string' ? packshotSrc : undefined;
const site = Astro.site!;
const imageUrls = await Promise.all(
  images.map(async (i) => {
    const src = resolveImageSource(i.src);
    if (typeof src === 'string') return new URL(src, site).href;
    return new URL((await getImage({ src, width: Math.min(1200, src.width), format: 'jpeg', quality: 80 })).src, site).href;
  }),
);
const jsonLd = await productJsonLd({
  slug: product.id,
  name: title,
  description: d.seo.description || d.description,
  url: new URL(`/shop/${product.id}/`, site).href,
  images: imageUrls,
  eur,
});
const big = '(min-width: 760px) calc(5 * var(--col) + 4 * var(--gutter)), calc(100vw - 40px)';
const half = '(min-width: 760px) 272px, calc((100vw - 48px) / 2)';
---

<Base
  title={d.seo.title || `${d.name} · Industrial Bloom · Humansize`}
  description={d.seo.description || d.description}
  image={ogImage}
  jsonLd={jsonLd}
  safeArea
>
  <article class="shop-detail page-grid" data-slug={product.id}>
    <div class="shop-detail-mark project-mark is-ring" data-project-menu>
      <a href="/shop/" aria-label="Industrial Bloom shop" data-project-face>
        <span class="shop-mark" data-spin-mark set:html={mark} />
      </a>
      <SmallMenu />
    </div>
    <header class="shop-detail-head">
      <h1>{title}<br /><span data-price={product.id} data-price-style="suffix">{priceText(eur, 'suffix')}</span></h1>
    </header>
    <div class="shop-detail-text">
      {intro.map((p) => <p set:html={renderInline(p)} />)}
    </div>
    {images.map((img, i) => (
      <figure class="shop-detail-image fade-in">
        <BlurImage src={resolveImageSource(img.src)} alt={img.alt} outline={img.outline === true} sizes={big} priority={i < 1} />
      </figure>
    ))}
    {detail.sections.map((s) => (
      <section class="shop-detail-section">
        {s.heading && <h2 class="shop-detail-heading">{s.heading}</h2>}
        {s.text && <div class="shop-detail-text">{paragraphs(s.text).map((p) => <p set:html={renderInline(p)} />)}</div>}
        {s.image?.src && (
          <figure class="shop-detail-image fade-in">
            <BlurImage src={resolveImageSource(s.image.src)} alt={s.image.alt} outline={s.image.outline === true} sizes={big} />
          </figure>
        )}
      </section>
    ))}
    {detail.wild.length > 0 && (
      <section class="shop-detail-section shop-wild">
        {detail.wildTitle && <h2 class="shop-detail-heading">{detail.wildTitle}</h2>}
        <div class="shop-wild-grid fade-in">
          {detail.wild.map((img) => <BlurImage src={resolveImageSource(img.src)} alt={img.alt} outline={img.outline === true} sizes={half} />)}
        </div>
      </section>
    )}
    <section class="shop-detail-section shop-detail-info">
      <Info items={info} />
    </section>
    
    <div class="shop-buy-bar">
      
      <form class="shop-buy-form" method="post" action="/api/shop/buy">
        <input type="hidden" name="slug" value={product.id} />
        <button class="shop-buy-button" type="submit" data-buy={product.id}>Buy</button>
      </form>
      <p class="shop-buy-note" data-buy-note hidden></p>
    </div>
  </article>
</Base>

<script>
  import { initSpinMark } from '../../scripts/spin-mark';
  import { initProjectMenu } from '../../scripts/project-menu';
  initProjectMenu();

  const start = () => {
    const el = document.querySelector<HTMLElement>('[data-spin-mark]');
    if (el) initSpinMark(el);
  };
  start();

  import { applyStock } from '../../lib/shop/label.mjs';
  import { applyPrices, showBuyNote } from '../../scripts/shop-price';
  showBuyNote();

  const refreshBuy = async () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-buy]');
    if (!btn) return;
    try {
      const res = await fetch('/api/shop/stock', { signal: AbortSignal.timeout(4000) });
      const data = res.ok ? await res.json() : null;
      applyStock(btn, btn.dataset.buy!, data);
      applyPrices(data);
    } catch {
      applyStock(btn, btn.dataset.buy!, null);
    }
  };
  refreshBuy();
  addEventListener('pageshow', (e) => {
    if (e.persisted) {
      start();
      refreshBuy();
    }
  });
</script>
