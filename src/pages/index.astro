---
export const prerender = true;

import Mark from '../components/Mark.astro';
import ProjectFeed from '../components/ProjectFeed.astro';
import Base from '../layouts/Base.astro';
import { absoluteUrl, getProjects, getSite, plainText } from '../lib/content';
import { resolveImage } from '../lib/images';
import { homeJsonLd } from '../lib/seo';

const site = await getSite();
const projects = await getProjects();
const cover = projects[0]?.data.cover;
const image = cover ? resolveImage(cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, '/');
const description = plainText(site.intro);
---

<Base
  title={site.studio}
  description={description}
  image={image}
  jsonLd={homeJsonLd(site, pageUrl)}
>
  <h1 class="sr-only">{site.name}, {site.studio}</h1>
  <section class="hero" aria-label="Humansize">
    <div class="mark-wrap">
      <Mark />
    </div>
  </section>
  <ProjectFeed projects={projects} about={site.about} />
</Base>
