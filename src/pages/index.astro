---
const title = 'Humansize';
const description =
  'Johann Schnettker is the designer behind Humansize, a studio for websites, 3D work and spaces you can walk into.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <h1>Humansize</h1>
      <p>{description}</p>
    </main>
  </body>
</html>
