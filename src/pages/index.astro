---
export const prerender = true;

import ArrowNav from '../components/ArrowNav.astro';
import Base from '../layouts/Base.astro';
import { getArrowNav } from '../lib/arrow-nav';
import { absoluteUrl, getSite } from '../lib/content';
import { homeJsonLd } from '../lib/seo';
import { positioning } from '../lib/positioning';

const site = await getSite();
const nav = await getArrowNav();
const pageUrl = absoluteUrl(Astro.site, '/');
---

<Base
  title={positioning.homeTitle}
  description={positioning.description}
  jsonLd={homeJsonLd(site, pageUrl)}
  header={false}
  hideFooter
>
  <ArrowNav tree={nav} />
</Base>
