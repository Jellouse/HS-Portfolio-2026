---
export const prerender = true;

import HeroBlob from '../components/HeroBlob.astro';
import Mark from '../components/Mark.astro';
import ProjectFeed from '../components/ProjectFeed.astro';
import IntroHero from '../components/sections/IntroHero.astro';
import Base from '../layouts/Base.astro';
import { absoluteUrl, getProjects, getSite } from '../lib/content';
import { resolveImage } from '../lib/images';
import { homeJsonLd } from '../lib/seo';
import { positioning } from '../lib/positioning';

const site = await getSite();
const projects = await getProjects();
const cover = projects[0]?.data.cover;
const image = cover ? resolveImage(cover) : undefined;
const pageUrl = absoluteUrl(Astro.site, '/');
const description = positioning.description;
---

<Base
  title={positioning.homeTitle}
  description={description}
  image={image}
  jsonLd={homeJsonLd(site, pageUrl)}
>
  <h1 class="sr-only">{site.name}, {site.studio}</h1>
  <IntroHero variant="home" site={site}>
    <HeroBlob slot="blob" />
    <Mark slot="gradient" />
  </IntroHero>
  <ProjectFeed projects={projects} about={site.about} />
</Base>
